From 01cf4aa17fc1c1072756dc5c87f3a98dae7451ee Mon Sep 17 00:00:00 2001
From: Deniz Kokden <koekdendeniz@gmail.com>
Date: Mon, 2 Nov 2026 08:34:01 +0000
Subject: [PATCH 043/109] ARM: dts: sc7730: SC2723 PMIC with RTC and EIC, keys
 on interrupts

The PMIC node carries the RTC (offset 0x80, PMIC IRQ 2) and the EIC
(offset 0x100, PMIC IRQ 5) for the mainline drivers. Power and volume
down move from gpio-keys-polled to gpio-keys, with the EIC's hardware
debounce of 50 ms as before; Power and the keypad (Home) wake the
tablet.

Assisted-by: Claude Opus 5.5
Signed-off-by: Deniz Kokden <koekdendeniz@gmail.com>
---
 .../dts/unisoc/sc7730-samsung-gtelwifi.dts    | 11 ++++--
 arch/arm/boot/dts/unisoc/sc7730.dtsi          | 34 +++++++++++++++----
 2 files changed, 36 insertions(+), 9 deletions(-)

diff --git a/arch/arm/boot/dts/unisoc/sc7730-samsung-gtelwifi.dts b/arch/arm/boot/dts/unisoc/sc7730-samsung-gtelwifi.dts
index c56e17054..3157ead79 100644
--- a/arch/arm/boot/dts/unisoc/sc7730-samsung-gtelwifi.dts
+++ b/arch/arm/boot/dts/unisoc/sc7730-samsung-gtelwifi.dts
@@ -67,22 +67,25 @@ charger: charger@6a {
 	/*
 	 * Power (PBINT) and Volume Down (EXT_RSTN) are PMIC inputs, not part
 	 * of the keypad matrix. Power + Volume Down held for ~7-10 s is a
-	 * hardware reset in the PMIC, independent of the kernel.
+	 * hardware reset in the PMIC, independent of the kernel. The EIC
+	 * debounces in hardware, 50 ms as the bootloader sets it.
 	 */
 	gpio-keys {
-		compatible = "gpio-keys-polled";
-		poll-interval = <50>;
+		compatible = "gpio-keys";
 
 		key-power {
 			label = "Power";
 			gpios = <&pmic_eic 2 GPIO_ACTIVE_HIGH>;
 			linux,code = <KEY_POWER>;
+			debounce-interval = <50>;
+			wakeup-source;
 		};
 
 		key-volume-down {
 			label = "Volume Down";
 			gpios = <&pmic_eic 10 GPIO_ACTIVE_HIGH>;
 			linux,code = <KEY_VOLUMEDOWN>;
+			debounce-interval = <50>;
 		};
 	};
 
@@ -356,6 +359,8 @@ &keypad {
 	keypad,num-columns = <3>;
 	linux,keymap = <MATRIX_KEY(0, 1, KEY_HOMEPAGE)
 			MATRIX_KEY(0, 2, KEY_VOLUMEUP)>;
+	/* Home wakes the tablet like on Android; Volume Up comes along */
+	wakeup-source;
 	status = "okay";
 };
 
diff --git a/arch/arm/boot/dts/unisoc/sc7730.dtsi b/arch/arm/boot/dts/unisoc/sc7730.dtsi
index f2af061ca..9454247f8 100644
--- a/arch/arm/boot/dts/unisoc/sc7730.dtsi
+++ b/arch/arm/boot/dts/unisoc/sc7730.dtsi
@@ -53,13 +53,35 @@ cpu3: cpu@f03 {
 	};
 
 	/*
-	 * EIC block of the SC2723 companion PMIC behind the ADI bus, polled
-	 * (mach-sprd/pmic-eic.c) until there is an sc27xx MFD for it.
+	 * SC2723 companion PMIC behind the ADI bus, as a regmap with its
+	 * interrupt controller (mach-sprd/sc2723-pmic.c) until spi-sprd-adi
+	 * and the sc27xx MFD know it. Children use the mainline drivers.
 	 */
-	pmic_eic: gpio-controller {
-		compatible = "sprd,sc2723-eic-polled";
-		gpio-controller;
-		#gpio-cells = <2>;
+	pmic: pmic {
+		compatible = "sprd,sc2723-adi-pmic";
+		interrupts = <GIC_SPI 38 IRQ_TYPE_LEVEL_HIGH>;
+		interrupt-controller;
+		#interrupt-cells = <2>;
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		rtc@80 {
+			compatible = "sprd,sc2731-rtc";
+			reg = <0x80>;
+			interrupt-parent = <&pmic>;
+			interrupts = <2 IRQ_TYPE_LEVEL_HIGH>;
+		};
+
+		pmic_eic: gpio@100 {
+			compatible = "sprd,sc2731-eic";
+			reg = <0x100>;
+			interrupt-parent = <&pmic>;
+			interrupts = <5 IRQ_TYPE_LEVEL_HIGH>;
+			gpio-controller;
+			#gpio-cells = <2>;
+			interrupt-controller;
+			#interrupt-cells = <2>;
+		};
 	};
 
 	/* SC2723 auxiliary ADC (mach-sprd/sc2723-adc.c), raw counts */
-- 

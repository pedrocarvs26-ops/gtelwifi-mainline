From fa848c196ff51f2cbbda248233582a4860429e96 Mon Sep 17 00:00:00 2001
From: Deniz Kokden <koekdendeniz@gmail.com>
Date: Sun, 1 Nov 2026 16:55:56 +0000
Subject: [PATCH 009/109] i2c: add Spreadtrum SC8830 controller; gtelwifi:
 GPIO, touchscreen

The 32-bit Spreadtrum SC8830/SC7730 I2C controllers are a byte-at-a-time
engine driven through a CMD register, unrelated to the FIFO IP that
i2c-sprd handles. Add a small polling driver modelled on the vendor 3.10
one; it also opens the AP APB clock gate and pulses the soft reset, since
the bootloader leaves this bus alone and there is no clock driver yet.

Describe the GPIO block (same layout as SC9860), the GPIO-switched 3.3 V
touch supply and the Zinitix ZT7554 on I2C1. Mainline zinitix with the
bt554 compatible works as-is: the firmware accepts report mode 2.

Assisted-by: Claude Opus 5.5
Signed-off-by: Deniz Kokden <koekdendeniz@gmail.com>
---
 .../dts/unisoc/sc7730-samsung-gtelwifi.dts    |  34 +++
 arch/arm/boot/dts/unisoc/sc7730.dtsi          |  27 ++
 drivers/i2c/busses/Kconfig                    |   8 +
 drivers/i2c/busses/Makefile                   |   1 +
 drivers/i2c/busses/i2c-sprd-sc8830.c          | 233 ++++++++++++++++++
 5 files changed, 303 insertions(+)
 create mode 100644 drivers/i2c/busses/i2c-sprd-sc8830.c

diff --git a/arch/arm/boot/dts/unisoc/sc7730-samsung-gtelwifi.dts b/arch/arm/boot/dts/unisoc/sc7730-samsung-gtelwifi.dts
index e41a5840e..dd3607b46 100644
--- a/arch/arm/boot/dts/unisoc/sc7730-samsung-gtelwifi.dts
+++ b/arch/arm/boot/dts/unisoc/sc7730-samsung-gtelwifi.dts
@@ -9,6 +9,40 @@
 /dts-v1/;
 
 #include "sc7730.dtsi"
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/interrupt-controller/irq.h>
+
+/ {
+	/* Touch supply: a GPIO-switched 3.3 V rail, not a PMIC LDO */
+	tsp_ldo: regulator-tsp {
+		compatible = "regulator-fixed";
+		regulator-name = "tsp_ldo";
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+		gpio = <&gpio 156 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		startup-delay-us = <200000>;	/* vendor waits 200 ms */
+	};
+};
+
+/*
+ * Zinitix ZT7554 (vendor "zinitix,zt7554_ts"); pinmux for I2C1 and the
+ * IRQ pad comes from the bootloader. GPIOs 81/83 only tell the vendor
+ * driver which firmware image to flash.
+ */
+&i2c1 {
+	status = "okay";
+
+	touchscreen@20 {
+		compatible = "zinitix,bt554";
+		reg = <0x20>;
+		interrupt-parent = <&gpio>;
+		interrupts = <82 IRQ_TYPE_EDGE_FALLING>;
+		vcca-supply = <&tsp_ldo>;
+		touchscreen-size-x = <800>;
+		touchscreen-size-y = <1280>;
+	};
+};
 
 / {
 	model = "Samsung Galaxy Tab E 9.6 (SM-T560)";
diff --git a/arch/arm/boot/dts/unisoc/sc7730.dtsi b/arch/arm/boot/dts/unisoc/sc7730.dtsi
index 68e359579..792b011a9 100644
--- a/arch/arm/boot/dts/unisoc/sc7730.dtsi
+++ b/arch/arm/boot/dts/unisoc/sc7730.dtsi
@@ -117,6 +117,33 @@ emmc: mmc@20600000 {
 			status = "disabled";
 		};
 
+		/* Same register layout as the SC9860 "d-gpio" block */
+		gpio: gpio@40280000 {
+			compatible = "sprd,sc9860-gpio";
+			reg = <0x40280000 0x1000>;
+			interrupts = <GIC_SPI 35 IRQ_TYPE_LEVEL_HIGH>;
+			gpio-controller;
+			#gpio-cells = <2>;
+			interrupt-controller;
+			#interrupt-cells = <2>;
+		};
+
+		/*
+		 * I2C1. Source clock 26 MHz (AP_CLK_I2C1_CFG mux 0, as the
+		 * vendor leaves it); gate and reset are bit 9 in AP_APB.
+		 */
+		i2c1: i2c@70600000 {
+			compatible = "sprd,sc8830-i2c";
+			reg = <0x70600000 0x1000>, <0x71300000 0x8>;
+			reg-names = "i2c", "ap-apb";
+			sprd,ap-apb-bit = <9>;
+			clocks = <&ext_26m>;
+			clock-frequency = <100000>;
+			#address-cells = <1>;
+			#size-cells = <0>;
+			status = "disabled";
+		};
+
 		uart1: serial@70100000 {
 			compatible = "sprd,sc9836-uart";
 			reg = <0x70100000 0x100>;

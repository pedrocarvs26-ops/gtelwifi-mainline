From 08bd1dac7e76ddc832e5c26646ad912961b40a03 Mon Sep 17 00:00:00 2001
From: Deniz Kokden <koekdendeniz@gmail.com>
Date: Mon, 2 Nov 2026 08:34:01 +0000
Subject: [PATCH 040/109] Input: sprd-sc8830-keypad: support wakeup-source

The matrix keeps scanning on the 32 kHz clock in suspend, so with
"wakeup-source" a key press (Home on the gtelwifi) wakes the system.

Assisted-by: Claude Opus 5.5
Signed-off-by: Deniz Kokden <koekdendeniz@gmail.com>
---
 drivers/input/keyboard/sprd-sc8830-keypad.c | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/drivers/input/keyboard/sprd-sc8830-keypad.c b/drivers/input/keyboard/sprd-sc8830-keypad.c
index 43b14be74..47e3ba33b 100644
--- a/drivers/input/keyboard/sprd-sc8830-keypad.c
+++ b/drivers/input/keyboard/sprd-sc8830-keypad.c
@@ -24,6 +24,7 @@
 #include <linux/mod_devicetable.h>
 #include <linux/module.h>
 #include <linux/platform_device.h>
+#include <linux/pm_wakeirq.h>
 #include <linux/property.h>
 #include <linux/slab.h>
 
@@ -214,6 +215,15 @@ static int sc8830_kpd_probe(struct platform_device *pdev)
 	if (ret)
 		return ret;
 
+	/* the matrix keeps scanning on the 32 kHz clock while we sleep */
+	if (device_property_read_bool(dev, "wakeup-source")) {
+		ret = devm_device_init_wakeup(dev);
+		if (!ret)
+			ret = devm_pm_set_wake_irq(dev, irq);
+		if (ret)
+			return ret;
+	}
+
 	ret = input_register_device(kpd->input);
 	if (ret)
 		return ret;
-- 

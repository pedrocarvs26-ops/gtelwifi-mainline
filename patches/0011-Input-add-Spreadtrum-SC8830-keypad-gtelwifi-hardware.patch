 .../dts/unisoc/sc7730-samsung-gtelwifi.dts    |  35 +++
 arch/arm/boot/dts/unisoc/sc7730.dtsi          |  23 ++
 arch/arm/mach-sprd/Makefile                   |   1 +
 arch/arm/mach-sprd/pmic-eic.c                 |  98 +++++++
 drivers/input/keyboard/Kconfig                |  13 +
 drivers/input/keyboard/Makefile               |   1 +
 drivers/input/keyboard/sprd-sc8830-keypad.c   | 244 ++++++++++++++++++
 8 files changed, 426 insertions(+)
 create mode 100644 arch/arm/mach-sprd/pmic-eic.c
 create mode 100644 drivers/input/keyboard/sprd-sc8830-keypad.c

diff --git a/arch/arm/Kconfig.platforms b/arch/arm/Kconfig.platforms
index cc273644d..4db904678 100644
--- a/arch/arm/Kconfig.platforms
+++ b/arch/arm/Kconfig.platforms
@@ -198,6 +198,17 @@ config SPRD_RESTART
 	  bootloader ("reboot recovery" boots the recovery partition) and
 	  lets the PMIC watchdog reset the system, as the vendor kernel does.
 
+config SPRD_PMIC_EIC
+	bool "SC2723 PMIC EIC inputs as polled GPIOs (bring-up glue)"
+	depends on ARCH_SPRD && GPIOLIB
+	select SPRD_ADI
+	help
+	  The power and volume down keys of SC7730 tablets hang off the
+	  EIC block of the SC2723 PMIC behind the ADI bus. This exposes
+	  its 16 inputs as a GPIO chip without interrupts, for
+	  gpio-keys-polled, until the mainline sc27xx drivers support
+	  the SC2723.
+
 config SPRD_ADI
 	bool
 
diff --git a/arch/arm/boot/dts/unisoc/sc7730-samsung-gtelwifi.dts b/arch/arm/boot/dts/unisoc/sc7730-samsung-gtelwifi.dts
index 6f15212e8..b4bcd0964 100644
--- a/arch/arm/boot/dts/unisoc/sc7730-samsung-gtelwifi.dts
+++ b/arch/arm/boot/dts/unisoc/sc7730-samsung-gtelwifi.dts
@@ -60,6 +60,28 @@ charger@6a {
 		};
 	};
 
+	/*
+	 * Power (PBINT) and Volume Down (EXT_RSTN) are PMIC inputs, not part
+	 * of the keypad matrix. Power + Volume Down held for ~7-10 s is a
+	 * hardware reset in the PMIC, independent of the kernel.
+	 */
+	gpio-keys {
+		compatible = "gpio-keys-polled";
+		poll-interval = <50>;
+
+		key-power {
+			label = "Power";
+			gpios = <&pmic_eic 2 GPIO_ACTIVE_HIGH>;
+			linux,code = <KEY_POWER>;
+		};
+
+		key-volume-down {
+			label = "Volume Down";
+			gpios = <&pmic_eic 10 GPIO_ACTIVE_HIGH>;
+			linux,code = <KEY_VOLUMEDOWN>;
+		};
+	};
+
 	battery: battery {
 		compatible = "simple-battery";
 		charge-full-design-microamp-hours = <5000000>;
@@ -161,6 +183,19 @@ framebuffer@9ea44000 {
 	};
 };
 
+/*
+ * Home and Volume Up: KEYOUT0 with KEYIN1/KEYIN2, the only keypad pads the
+ * bootloader muxes to the keypad. The vendor tree also lists Volume Down
+ * at row 1/column 0, but never scans column 0.
+ */
+&keypad {
+	keypad,num-rows = <1>;
+	keypad,num-columns = <3>;
+	linux,keymap = <MATRIX_KEY(0, 1, KEY_HOMEPAGE)
+			MATRIX_KEY(0, 2, KEY_VOLUMEUP)>;
+	status = "okay";
+};
+
 &usb {
 	status = "okay";
 };

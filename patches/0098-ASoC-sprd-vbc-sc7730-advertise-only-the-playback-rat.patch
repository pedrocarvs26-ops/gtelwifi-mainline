From 11962f44065212105596c07da702283ec42fbe7f Mon Sep 17 00:00:00 2001
From: Deniz Kokden <koekdendeniz@gmail.com>
Date: Wed, 4 Nov 2026 20:20:40 +0000
Subject: [PATCH 098/110] ASoC: sprd: vbc-sc7730: advertise only the playback
 rates it supports

The playback DAI claimed SNDRV_PCM_RATE_8000_96000, but hw_params() only
accepts the rates that have a DAC_RATE code and returns -EINVAL for the
others (64 and 88.2 kHz). Android's audio policy picked 64 kHz for the
speaker from the advertised range (LineageOS, 04.11.2026). List exactly
the rates of the table instead.

Assisted-by: Claude Opus 5.5
---
 sound/soc/sprd/sprd-vbc-sc7730.c | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/sound/soc/sprd/sprd-vbc-sc7730.c b/sound/soc/sprd/sprd-vbc-sc7730.c
index 156a354d5..9988e8d02 100644
--- a/sound/soc/sprd/sprd-vbc-sc7730.c
+++ b/sound/soc/sprd/sprd-vbc-sc7730.c
@@ -289,7 +289,12 @@ static struct snd_soc_dai_driver sprd_vbc_dai = {
 		.stream_name = "VBC Playback",
 		.channels_min = 1,
 		.channels_max = 2,
-		.rates = SNDRV_PCM_RATE_8000_96000,
+		/* exactly the DAC_RATE codes in sprd_vbc_rates[] */
+		.rates = SNDRV_PCM_RATE_8000 | SNDRV_PCM_RATE_11025 |
+			 SNDRV_PCM_RATE_12000 | SNDRV_PCM_RATE_16000 |
+			 SNDRV_PCM_RATE_22050 | SNDRV_PCM_RATE_24000 |
+			 SNDRV_PCM_RATE_32000 | SNDRV_PCM_RATE_44100 |
+			 SNDRV_PCM_RATE_48000 | SNDRV_PCM_RATE_96000,
 		.formats = SNDRV_PCM_FMTBIT_S16_LE,
 	},
 	.capture = {
-- 

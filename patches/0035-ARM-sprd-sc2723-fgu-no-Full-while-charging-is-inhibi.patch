From eaded7424b3ba27131866dbab7a4fb1fd687bd3f Mon Sep 17 00:00:00 2001
From: Deniz Kokden <koekdendeniz@gmail.com>
Date: Sun, 1 Nov 2026 23:17:58 +0000
Subject: [PATCH 035/110] ARM: sprd: sc2723-fgu: no Full while charging is
 inhibited

smb347 reports Full whenever the charger terminated once and no charge
phase is active, which is also the state while the fuel gauge inhibits
charging for the battery temperature. Do not re-anchor to 100 % then.

Assisted-by: Claude Opus 5.5
Signed-off-by: Deniz Kokden <koekdendeniz@gmail.com>
---
 arch/arm/mach-sprd/sc2723-fgu.c | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/arch/arm/mach-sprd/sc2723-fgu.c b/arch/arm/mach-sprd/sc2723-fgu.c
index 6df13a84e..c4196f7d0 100644
--- a/arch/arm/mach-sprd/sc2723-fgu.c
+++ b/arch/arm/mach-sprd/sc2723-fgu.c
@@ -311,7 +311,11 @@ static void sc2723_fgu_update(struct sc2723_fgu *fgu)
 	 * from the battery until the charger restarts, keep 100 % meanwhile.
 	 */
 	supplied = power_supply_am_i_supplied(fgu->psy) > 0;
-	full = supplied && sc2723_fgu_charger_full(fgu);
+	/*
+	 * smb347 also reads Full when it terminated once and charging is
+	 * now off, which is the case while we inhibit it for the temperature.
+	 */
+	full = supplied && !fgu->inhibited && sc2723_fgu_charger_full(fgu);
 	if (full || ocv >= fgu->info->constant_charge_voltage_max_uv)
 		soc = 100;
 	else if (uv < fgu->info->voltage_min_design_uv)
-- 

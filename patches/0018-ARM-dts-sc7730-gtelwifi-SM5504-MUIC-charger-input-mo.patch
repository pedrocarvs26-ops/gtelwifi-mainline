From 2d5923900597aae394c54b7f102cab3db4a7d4f1 Mon Sep 17 00:00:00 2001
From: Deniz Kokden <koekdendeniz@gmail.com>
Date: Sun, 1 Nov 2026 20:04:37 +0000
Subject: [PATCH 018/109] ARM: dts: sc7730-gtelwifi: SM5504 MUIC, charger input
 mode

The SM5504 sits on a second bit-banged bus (GPIO 150/151), the
bootloader leaves it in automatic switching. Link it to the SMB358 so
the charger uses high-current mode on chargers: 1.8 A on a wall charger
(vendor value), 1.5 A on a charging host port.

Assisted-by: Claude Opus 5.5
Signed-off-by: Deniz Kokden <koekdendeniz@gmail.com>
---
 .../dts/unisoc/sc7730-samsung-gtelwifi.dts    | 32 +++++++++++++++++--
 1 file changed, 29 insertions(+), 3 deletions(-)

diff --git a/arch/arm/boot/dts/unisoc/sc7730-samsung-gtelwifi.dts b/arch/arm/boot/dts/unisoc/sc7730-samsung-gtelwifi.dts
index 7ce91f082..916a53ab0 100644
--- a/arch/arm/boot/dts/unisoc/sc7730-samsung-gtelwifi.dts
+++ b/arch/arm/boot/dts/unisoc/sc7730-samsung-gtelwifi.dts
@@ -42,11 +42,8 @@ i2c-chg {
 		 * sboot leaves a 4.35 V float, charging on, termination off.
 		 * The vendor kernel set 4.32 V; smb347 rewrites only what is
 		 * given here (volatile copies, reloaded from NVM at POR).
-		 * Input stays in sboot's 500 mA USB mode (CMD_B untouched).
 		 * No temperature properties: those would switch on the
 		 * chip's NTC monitor, which the vendor keeps off (0x07 bit 4).
-		 * No input current limits: the mainline SMB358 table differs
-		 * from the one in sboot and the vendor driver.
 		 */
 		charger: charger@6a {
 			compatible = "summit,smb358";
@@ -56,6 +53,13 @@ charger: charger@6a {
 			summit,enable-usb-charging;
 			summit,enable-charge-control = <SMB3XX_CHG_ENABLE_SW>;
 			summit,fast-voltage-threshold-microvolt = <2400000>;
+			/*
+			 * High-current input mode by the MUIC's charger type:
+			 * 1.8 A on a wall charger (vendor value), 1.5 A on a
+			 * charging host port, 500 mA on a plain one.
+			 */
+			extcon = <&muic>;
+			summit,mains-current-limit-microamp = <1800000>;
 			monitored-battery = <&battery>;
 		};
 	};
@@ -106,6 +110,28 @@ fuel-gauge {
 		sprd,calib-resistance-micro-ohms = <20200>;
 	};
 
+	/*
+	 * Bit-banged bus to the SM5504 MUIC, which tells USB host ports
+	 * (SDP/CDP) from wall chargers (DCP) for the charger's input limit.
+	 * The bootloader leaves it in automatic switching, the USB data
+	 * path does not depend on the driver.
+	 */
+	i2c-muic {
+		compatible = "i2c-gpio";
+		sda-gpios = <&gpio 150 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
+		scl-gpios = <&gpio 151 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
+		i2c-gpio,delay-us = <10>;
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		muic: extcon@14 {
+			compatible = "siliconmitus,sm5504-muic";
+			reg = <0x14>;
+			interrupt-parent = <&gpio>;
+			interrupts = <149 IRQ_TYPE_EDGE_FALLING>;
+		};
+	};
+
 	/* 5000 mAh, data from the vendor sec-fuelgauge/sec-battery nodes */
 	battery: battery {
 		compatible = "simple-battery";
-- 

From 1c3d9d63efda23fa1dccd1e27dceab6d8b3dd17f Mon Sep 17 00:00:00 2001
From: Deniz Kokden <koekdendeniz@gmail.com>
Date: Sun, 1 Nov 2026 14:45:10 +0000
Subject: [PATCH 003/110] ARM: sprd: gtelwifi: dwc2 FIFO sizes, dump core
 config

dwc2 defaults (RX 2048, NP TX 1024, averaged TX FIFOs) exceed what this
core was synthesized with; after clamping no TX FIFO was left for a
512-byte HS bulk IN endpoint ("No suitable fifo found"), so the ACM
function enumerated but never moved data. Use the vendor dwc_otg sizes
for SCX35, trimmed to the 3598-word SPRAM, and log the reset values of
GHWCFG1-4 and the FIFO size registers.

Also stop bootstripes from reserving the framebuffer the device tree
already reserves, which made the reserved-memory node fail.

Assisted-by: Claude Opus 5.5
Signed-off-by: Deniz Kokden <koekdendeniz@gmail.com>
---
 arch/arm/boot/dts/unisoc/sc7730.dtsi |  9 +++++++++
 arch/arm/mach-sprd/bootstripes.c     |  9 +++++++--
 arch/arm/mach-sprd/usb-bringup.c     | 22 +++++++++++++++++++++-
 3 files changed, 37 insertions(+), 3 deletions(-)

diff --git a/arch/arm/boot/dts/unisoc/sc7730.dtsi b/arch/arm/boot/dts/unisoc/sc7730.dtsi
index b46247b0d..e5caae400 100644
--- a/arch/arm/boot/dts/unisoc/sc7730.dtsi
+++ b/arch/arm/boot/dts/unisoc/sc7730.dtsi
@@ -68,6 +68,11 @@ timer@40050000 {
 		 * clock and resets are still done by mach-sprd/usb-bringup.c.
 		 * No VBUS sensing wired to the core: the role switch override
 		 * forces the B-session valid, like the vendor driver does.
+		 *
+		 * FIFOs (32-bit words) as in the vendor dwc_otg for SCX35, only
+		 * TX FIFO 15 trimmed so everything fits the 3598-word SPRAM.
+		 * TX FIFOs 1 and 2 are only 0x40 deep, too small for HS bulk;
+		 * the dwc2 defaults left no FIFO for a 512-byte bulk IN endpoint.
 		 */
 		usb: usb@20200000 {
 			compatible = "snps,dwc2";
@@ -76,6 +81,10 @@ usb: usb@20200000 {
 			dr_mode = "peripheral";
 			usb-role-switch;
 			role-switch-default-mode = "peripheral";
+			g-rx-fifo-size = <0x320>;
+			g-np-tx-fifo-size = <0x10>;
+			g-tx-fifo-size = <0x40 0x40 0x100 0x100 0x100 0x100 0x100
+					  0x80 0x80 0x80 0x80 0x80 0x80 0x80 0x100>;
 			status = "disabled";
 		};
 
diff --git a/arch/arm/mach-sprd/bootstripes.c b/arch/arm/mach-sprd/bootstripes.c
index 31782bdfb..2daaf80b2 100644
--- a/arch/arm/mach-sprd/bootstripes.c
+++ b/arch/arm/mach-sprd/bootstripes.c
@@ -28,7 +28,8 @@
 #define BAND_H		80
 
 /* Fallback: buffer reserved for the display by the vendor device tree */
-static phys_addr_t lcd_base = 0x9ea44000;
+#define DT_LCD_BASE	0x9ea44000
+static phys_addr_t lcd_base = DT_LCD_BASE;
 static u32 __iomem *fb;
 
 /*
@@ -36,7 +37,9 @@ static u32 __iomem *fb;
  * the buffer can still be removed from the linear map here. That is
  * required: ARM refuses ioremap() of RAM that is linearly mapped, and the
  * kernel must never hand out the pages the display is scanning out.
- * Without lcd_base= the device tree reserves the fallback region.
+ * The device tree reserves the usual buffer (no-map) itself; reserving it
+ * here as well makes its reserved-memory node fail, so only a buffer at
+ * another address is taken out here.
  */
 static int __init sprd_lcd_base_setup(char *s)
 {
@@ -45,6 +48,8 @@ static int __init sprd_lcd_base_setup(char *s)
 	if (!s || kstrtoul(s, 16, &v) || !v)
 		return 0;
 	lcd_base = v;
+	if (lcd_base == DT_LCD_BASE)
+		return 0;
 	memblock_reserve(lcd_base, PAGE_ALIGN(FB_SIZE));
 	memblock_mark_nomap(lcd_base, PAGE_ALIGN(FB_SIZE));
 	return 0;
diff --git a/arch/arm/mach-sprd/usb-bringup.c b/arch/arm/mach-sprd/usb-bringup.c
index c81cdb471..70b8a279f 100644
--- a/arch/arm/mach-sprd/usb-bringup.c
+++ b/arch/arm/mach-sprd/usb-bringup.c
@@ -24,6 +24,7 @@
 #include <linux/io.h>
 #include <linux/of.h>
 #include <linux/printk.h>
+#include <linux/sprintf.h>
 
 #define ADI_PHYS		0x40030000
 #define ADI_RD_CMD		0x24
@@ -55,7 +56,11 @@
 #define AP_APB_PHY_CTRL_BIT9	BIT(9)
 
 #define USB_PHYS		0x20200000
+#define DWC2_GRXFSIZ		0x24
+#define DWC2_GNPTXFSIZ		0x28
 #define DWC2_GSNPSID		0x40
+#define DWC2_GHWCFG(n)		(0x44 + 4 * ((n) - 1))
+#define DWC2_DPTXFSIZN(n)	(0x104 + 4 * ((n) - 1))
 
 /* "tune_value" of the vendor usb@f5116000 node for gtelwifi */
 #define GTELWIFI_PHY_TUNE	0x44076e33
@@ -119,7 +124,7 @@ static int __init sprd_usb_bringup(void)
 	aon = ioremap(AON_APB_PHYS, 0x100);
 	ahb = ioremap(AP_AHB_PHYS, 0x100);
 	apb = ioremap(AP_APB_PHYS + AP_APB_USB_PHY_TUNE, 0x10);
-	usb = ioremap(USB_PHYS, 0x100);
+	usb = ioremap(USB_PHYS, 0x200);
 	if (!adi || !ana || !aon || !ahb || !apb || !usb) {
 		pr_err("sprd-usb: ioremap failed\n");
 		goto out;
@@ -156,6 +161,21 @@ static int __init sprd_usb_bringup(void)
 	pr_info("sprd-usb: after: PWR_CTRL %08x AHB_EB %08x PHY_CTRL %08x TUNE %08x GSNPSID %08x\n",
 		readl(aon + AON_APB_PWR_CTRL), readl(ahb + AP_AHB_EB),
 		readl(apb + 8), readl(apb), readl(usb + DWC2_GSNPSID));
+
+	/* Reset values = what the core was synthesized with (FIFO maxima) */
+	pr_info("sprd-usb: GHWCFG1-4 %08x %08x %08x %08x GRXFSIZ %08x GNPTXFSIZ %08x\n",
+		readl(usb + DWC2_GHWCFG(1)), readl(usb + DWC2_GHWCFG(2)),
+		readl(usb + DWC2_GHWCFG(3)), readl(usb + DWC2_GHWCFG(4)),
+		readl(usb + DWC2_GRXFSIZ), readl(usb + DWC2_GNPTXFSIZ));
+	{
+		char buf[16 * 6] = "", *p = buf;
+		int n;
+
+		for (n = 1; n <= 15; n++)
+			p += scnprintf(p, buf + sizeof(buf) - p, " %x",
+				       readl(usb + DWC2_DPTXFSIZN(n)) >> 16);
+		pr_info("sprd-usb: DPTXFSIZ1-15 depth:%s\n", buf);
+	}
 out:
 	if (usb)
 		iounmap(usb);
-- 
2.34.1


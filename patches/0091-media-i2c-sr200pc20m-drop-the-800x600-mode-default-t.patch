From 24f9e8c0751ccced1b52b705fc9a18e7aa421b6a Mon Sep 17 00:00:00 2001
From: Deniz Kokden <koekdendeniz@gmail.com>
Date: Tue, 3 Nov 2026 11:57:28 +0000
Subject: [PATCH 091/110] media: i2c: sr200pc20m: drop the 800x600 mode,
 default to 640x480

Camera applications keep the sensor's default format for the preview,
and the default was the first mode, 800x600. The stock HAL's 800x600
table runs the sensor at 8 fps, the 640x480 table at 24 fps (measured
with both through the DCAM). In GNOME Snapshot the front camera preview
therefore ran at 8 fps.

Drop the 800x600 mode, which makes 640x480 the first and default mode.
1600x1200 stays for stills.

Assisted-by: Claude Opus 5.5
---
 drivers/media/i2c/sr200pc20m.c | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/drivers/media/i2c/sr200pc20m.c b/drivers/media/i2c/sr200pc20m.c
index 240bb80b3..2dbede3d4 100644
--- a/drivers/media/i2c/sr200pc20m.c
+++ b/drivers/media/i2c/sr200pc20m.c
@@ -62,8 +62,12 @@ struct sr200_mode {
 /* lane rates of the HAL: 192, 288 and 384 Mbit/s, DDR */
 static const s64 sr200_link_freqs[] = { 96000000, 144000000, 192000000 };
 
+/*
+ * The first mode is the default, which camera applications tend to keep
+ * for the preview. The HAL's 800x600 table runs at 8 fps, so it is left
+ * out; 640x480 runs at 24 fps.
+ */
 static const struct sr200_mode sr200_modes[] = {
-	{ 800, 600, "sr200pc20m/800x600.bin", true, 0 },
 	/* the HAL's 640x480 table is a complete init of its own */
 	{ 640, 480, "sr200pc20m/640x480.bin", false, 1 },
 	{ 1600, 1200, "sr200pc20m/1600x1200.bin", true, 2 },
-- 

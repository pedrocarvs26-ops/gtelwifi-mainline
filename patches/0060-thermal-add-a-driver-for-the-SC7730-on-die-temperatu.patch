From 403e9563292b665389b9592929b89912b8b9069c Mon Sep 17 00:00:00 2001
From: Deniz Kokden <koekdendeniz@gmail.com>
Date: Mon, 2 Nov 2026 12:44:41 +0000
Subject: [PATCH 060/109] thermal: add a driver for the SC7730 on-die
 temperature sensor

The 32-bit Spreadtrum SC7730/SC8830 SoCs have a temperature sensor block
at 0x402f0000 that the bootloader leaves gated off. Its layout has
nothing in common with the SC9860 sensor of sprd_thermal.c.

The driver opens the gate, the RTC clock and the reset in AON APB, starts
sensor 0 with the vendor settings (2.25 s detect period) and reports it
through a thermal zone from the device tree. The vendor converts the raw
value linearly from 623 at -40 C to 1030 at 120 C, without calibration.
Trip interrupts are not used, the zone is polled.

The SoC gets a cpu-thermal zone with a hot trip at 100 C and the vendor's
critical shutdown at 110 C; without CPU frequency scaling the vendor's
passive trips have nothing to act on.

On the Galaxy Tab E 9.6 (SM-T560): 43 C idle while charging (battery
41 C), 57 C after 15 s of load on all four cores.

Assisted-by: Claude Opus 5.5
Signed-off-by: Deniz Kokden <koekdendeniz@gmail.com>
---
 arch/arm/boot/dts/unisoc/sc7730.dtsi  |  37 +++++++
 drivers/thermal/Kconfig               |   9 ++
 drivers/thermal/Makefile              |   1 +
 drivers/thermal/sprd-sc7730-thermal.c | 152 ++++++++++++++++++++++++++
 4 files changed, 199 insertions(+)
 create mode 100644 drivers/thermal/sprd-sc7730-thermal.c

diff --git a/arch/arm/boot/dts/unisoc/sc7730.dtsi b/arch/arm/boot/dts/unisoc/sc7730.dtsi
index 9f5da0c3b..3aa664d80 100644
--- a/arch/arm/boot/dts/unisoc/sc7730.dtsi
+++ b/arch/arm/boot/dts/unisoc/sc7730.dtsi
@@ -126,6 +126,32 @@ timer {
 		arm,cpu-registers-not-fw-configured;
 	};
 
+	/*
+	 * No CPU frequency scaling yet, so the vendor's passive trips (80, 88
+	 * and 100 C) have nothing to act on: a hot notification at 100 C and
+	 * the vendor's critical shutdown at 110 C.
+	 */
+	thermal-zones {
+		cpu-thermal {
+			polling-delay = <2000>;
+			thermal-sensors = <&ap_thm>;
+
+			trips {
+				cpu-hot {
+					temperature = <100000>;
+					hysteresis = <5000>;
+					type = "hot";
+				};
+
+				cpu-critical {
+					temperature = <110000>;
+					hysteresis = <0>;
+					type = "critical";
+				};
+			};
+		};
+	};
+
 	ext_32k: clock-32k {
 		compatible = "fixed-clock";
 		#clock-cells = <0>;
@@ -165,6 +191,17 @@ pmu_domains: power-controller@402b0000 {
 			#power-domain-cells = <1>;
 		};
 
+		/*
+		 * On-die temperature sensor, gated off after the bootloader;
+		 * gate, RTC clock and reset in AON APB. Polled (SPI 26 unused).
+		 */
+		ap_thm: thermal-sensor@402f0000 {
+			compatible = "sprd,sc7730-thermal";
+			reg = <0x402f0000 0x1000>, <0x402e0000 0x4000>;
+			reg-names = "thm", "aon-apb";
+			#thermal-sensor-cells = <0>;
+		};
+
 		/* AP AHB enable bits as gate clocks (mach-sprd/clk-gates.c) */
 		ap_ahb_gates: clock-controller@20d00000 {
 			compatible = "sprd,sc7730-gates";
diff --git a/drivers/thermal/Kconfig b/drivers/thermal/Kconfig
index 810eecced..e1b3ea626 100644
--- a/drivers/thermal/Kconfig
+++ b/drivers/thermal/Kconfig
@@ -508,6 +508,15 @@ config SPRD_THERMAL
 	  Support for the Spreadtrum thermal sensor driver in the Linux thermal
 	  framework.
 
+config SPRD_SC7730_THERMAL
+	tristate "Temperature sensor on Spreadtrum SC7730/SC8830"
+	depends on ARCH_SPRD || COMPILE_TEST
+	depends on OF
+	help
+	  Support for the on-die temperature sensor of the 32-bit Spreadtrum
+	  SC7730/SC8830 ("shark") SoCs, polled through a thermal zone from
+	  the device tree.
+
 config KHADAS_MCU_FAN_THERMAL
 	tristate "Khadas MCU controller FAN cooling support"
 	depends on OF
diff --git a/drivers/thermal/Makefile b/drivers/thermal/Makefile
index 3b249195c..c17639970 100644
--- a/drivers/thermal/Makefile
+++ b/drivers/thermal/Makefile
@@ -67,6 +67,7 @@ obj-$(CONFIG_UNIPHIER_THERMAL)	+= uniphier_thermal.o
 obj-$(CONFIG_AMLOGIC_THERMAL)     += amlogic_thermal.o
 obj-y				+= spacemit/
 obj-$(CONFIG_SPRD_THERMAL)	+= sprd_thermal.o
+obj-$(CONFIG_SPRD_SC7730_THERMAL)	+= sprd-sc7730-thermal.o
 obj-$(CONFIG_KHADAS_MCU_FAN_THERMAL)	+= khadas_mcu_fan.o
 obj-$(CONFIG_LOONGSON2_THERMAL)	+= loongson2_thermal.o
 obj-$(CONFIG_THERMAL_CORE_TESTING)	+= testing/
diff --git a/drivers/thermal/sprd-sc7730-thermal.c b/drivers/thermal/sprd-sc7730-thermal.c
new file mode 100644
index 000000000..230a4ff01
--- /dev/null
+++ b/drivers/thermal/sprd-sc7730-thermal.c
@@ -0,0 +1,152 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * On-die temperature sensor of the Spreadtrum SC7730/SC8830 ("shark")
+ * application processor (vendor: sprd_thm with the SC2713S backend).
+ *
+ * The sensor block at 0x402f0000 is gated off after the bootloader. Its
+ * gate, its RTC clock and its reset sit in AON APB ("aon-apb" region,
+ * shared with other drivers, so mapped without request_mem_region). Once
+ * started the sensor converts every 2.25 s; the reading is linear from
+ * 623 at -40 C to 1030 at 120 C (vendor table, no calibration).
+ */
+
+#include <linux/bits.h>
+#include <linux/delay.h>
+#include <linux/io.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/thermal.h>
+
+#define THM_CTRL		0x00
+#define  THM_SEN0_EN		BIT(0)
+#define THM_INT_CTRL		0x04
+#define SENSOR_CTRL		0x20
+#define  SENSOR_EN		BIT(0)
+#define  SENSOR_SET_RDY		BIT(3)
+#define  SENSOR_VENDOR_CFG	0x161	/* enable + detect setup (vendor) */
+#define SENSOR_DET_PERI		0x24
+#define  SENSOR_DET_2_25S	BIT(13)
+#define SENSOR_INT_CTRL		0x28
+#define SENSOR_INT_CLR		0x34
+#define SENSOR_TEMPER0_READ	0x60
+#define  SENSOR_RAW		GENMASK(14, 0)
+#define SENSOR_READ_STATUS	0x70
+/* sensor 1 shares the detect setting (vendor: "from HW") */
+#define SENSOR1_CTRL		0x120
+#define  SENSOR1_SEN_DET	0x60
+
+#define AON_APB_EB1		0x04
+#define  AON_APB_THM_EB		BIT(1)
+#define AON_APB_RST1		0x0c
+#define  AON_APB_THM_RST	BIT(1)
+#define AON_APB_RTC_EB		0x10
+#define  AON_APB_THM_RTC_EB	(BIT(10) | BIT(11) | BIT(13))
+
+#define RAW_AT_MINUS_40		623
+#define RAW_AT_120		1030
+
+struct sc7730_thm {
+	void __iomem *base;
+};
+
+static void sc7730_thm_setbits(void __iomem *reg, u32 bits)
+{
+	writel(readl(reg) | bits, reg);
+}
+
+static void sc7730_thm_clrbits(void __iomem *reg, u32 bits)
+{
+	writel(readl(reg) & ~bits, reg);
+}
+
+static int sc7730_thm_get_temp(struct thermal_zone_device *tz, int *temp)
+{
+	struct sc7730_thm *thm = thermal_zone_device_priv(tz);
+	int raw = readl(thm->base + SENSOR_TEMPER0_READ) & SENSOR_RAW;
+
+	/* zero until the first conversion */
+	if (!raw)
+		return -EAGAIN;
+
+	*temp = -40000 + (raw - RAW_AT_MINUS_40) * 160000 /
+		(RAW_AT_120 - RAW_AT_MINUS_40);
+	return 0;
+}
+
+static const struct thermal_zone_device_ops sc7730_thm_ops = {
+	.get_temp = sc7730_thm_get_temp,
+};
+
+static int sc7730_thm_aon_init(struct platform_device *pdev)
+{
+	struct resource *res;
+	void __iomem *aon;
+
+	res = platform_get_resource_byname(pdev, IORESOURCE_MEM, "aon-apb");
+	if (!res)
+		return -EINVAL;
+	aon = devm_ioremap(&pdev->dev, res->start, resource_size(res));
+	if (!aon)
+		return -ENOMEM;
+
+	sc7730_thm_setbits(aon + AON_APB_EB1, AON_APB_THM_EB);
+	sc7730_thm_setbits(aon + AON_APB_RTC_EB, AON_APB_THM_RTC_EB);
+	sc7730_thm_setbits(aon + AON_APB_RST1, AON_APB_THM_RST);
+	udelay(10);
+	sc7730_thm_clrbits(aon + AON_APB_RST1, AON_APB_THM_RST);
+	return 0;
+}
+
+static int sc7730_thm_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct thermal_zone_device *tz;
+	struct sc7730_thm *thm;
+	int ret;
+
+	thm = devm_kzalloc(dev, sizeof(*thm), GFP_KERNEL);
+	if (!thm)
+		return -ENOMEM;
+
+	thm->base = devm_platform_ioremap_resource_byname(pdev, "thm");
+	if (IS_ERR(thm->base))
+		return PTR_ERR(thm->base);
+
+	ret = sc7730_thm_aon_init(pdev);
+	if (ret)
+		return dev_err_probe(dev, ret, "no AON APB region\n");
+
+	/* polled: no trip interrupts */
+	sc7730_thm_setbits(thm->base + THM_CTRL, THM_SEN0_EN);
+	writel(0, thm->base + SENSOR_INT_CTRL);
+	writel(~0, thm->base + SENSOR_INT_CLR);
+	sc7730_thm_setbits(thm->base + SENSOR_DET_PERI, SENSOR_DET_2_25S);
+	sc7730_thm_setbits(thm->base + SENSOR1_CTRL, SENSOR1_SEN_DET);
+	sc7730_thm_setbits(thm->base + SENSOR_CTRL, SENSOR_VENDOR_CFG);
+	sc7730_thm_setbits(thm->base + SENSOR_CTRL, SENSOR_SET_RDY);
+
+	tz = devm_thermal_of_zone_register(dev, 0, thm, &sc7730_thm_ops);
+	if (IS_ERR(tz))
+		return dev_err_probe(dev, PTR_ERR(tz),
+				     "failed to register thermal zone\n");
+	return 0;
+}
+
+static const struct of_device_id sc7730_thm_of_match[] = {
+	{ .compatible = "sprd,sc7730-thermal" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, sc7730_thm_of_match);
+
+static struct platform_driver sc7730_thm_driver = {
+	.probe = sc7730_thm_probe,
+	.driver = {
+		.name = "sprd-sc7730-thermal",
+		.of_match_table = sc7730_thm_of_match,
+	},
+};
+module_platform_driver(sc7730_thm_driver);
+
+MODULE_DESCRIPTION("Spreadtrum SC7730 on-die temperature sensor");
+MODULE_LICENSE("GPL");
-- 
2.34.1


diff --git a/arch/arm/mach-sprd/sc2723-adc.c b/arch/arm/mach-sprd/sc2723-adc.c
new file mode 100644
index 000000000..8c8e62e4c
--- /dev/null
+++ b/arch/arm/mach-sprd/sc2723-adc.c
@@ -0,0 +1,161 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Auxiliary ADC of the SC2723 PMIC as an IIO device, raw counts only.
+ *
+ * One software conversion at a time, as the vendor 3.10 kernel does it
+ * (arch/arm/mach-sc/adc.c): select the input in SW_CH_CFG (small scale,
+ * quick mode, resistance path), start a single 12-bit sample with
+ * SW_CH_ON and wait for the raw interrupt status. On the gtelwifi the
+ * battery thermistor is channel 1. The vendor kernel shares the block
+ * with the modem CPU under a hardware spinlock; nothing else uses it here.
+ *
+ * Bring-up glue on top of the ADI helpers, like the other SC2723 drivers
+ * in this directory, until mainline sc27xx_adc knows the SC2723 (other
+ * global register offsets, scale in bit 5 instead of bits 10:9).
+ */
+
+#include <linux/bitfield.h>
+#include <linux/bits.h>
+#include <linux/delay.h>
+#include <linux/iio/iio.h>
+#include <linux/mod_devicetable.h>
+#include <linux/mutex.h>
+#include <linux/platform_device.h>
+
+#include "adi.h"
+
+#define SC2723_ADC(x)		(0x300 + (x))
+#define ADC_CTL			SC2723_ADC(0x00)
+#define ADC_CTL_EN		BIT(0)
+#define ADC_CTL_SW_CH_ON	BIT(1)
+#define ADC_CTL_12BIT		BIT(2)
+#define ADC_CTL_RUN_NUM		GENMASK(7, 4)	/* samples - 1 */
+#define ADC_SW_CH_CFG		SC2723_ADC(0x04)
+#define ADC_CH_ID		GENMASK(4, 0)
+#define ADC_DAT			SC2723_ADC(0x4c)
+#define ADC_IRQ_CLR		SC2723_ADC(0x54)
+#define ADC_IRQ_RAW		SC2723_ADC(0x5c)
+
+#define GLB_ARM_MODULE_EN	SC2723_GLB(0x000)
+#define GLB_ADC_EN		BIT(6)
+#define GLB_ARM_CLK_EN		SC2723_GLB(0x004)
+#define GLB_CLK_AUXADC_EN	(BIT(9) | BIT(8))
+#define GLB_XTL_WAIT_CTRL	SC2723_GLB(0x0e8)
+#define GLB_XTL_EN		BIT(8)
+
+#define SC2723_ADC_CHANNELS	32
+
+struct sc2723_adc {
+	struct mutex lock;	/* one conversion at a time */
+};
+
+static int sc2723_adc_convert(struct sc2723_adc *adc, int channel, int *raw)
+{
+	u32 ctl, val = 0;
+	int i, ret;
+
+	mutex_lock(&adc->lock);
+	ret = sprd_adi_write(ADC_SW_CH_CFG, FIELD_PREP(ADC_CH_ID, channel));
+	if (!ret)
+		ret = sprd_adi_read(ADC_CTL, &ctl);
+	if (ret)
+		goto out;
+
+	ctl &= ~(ADC_CTL_EN | ADC_CTL_SW_CH_ON | ADC_CTL_12BIT | ADC_CTL_RUN_NUM);
+	sprd_adi_write(ADC_CTL, ctl);
+	sprd_adi_write(ADC_IRQ_CLR, 1);
+	sprd_adi_write(ADC_CTL, ctl | ADC_CTL_EN | ADC_CTL_12BIT |
+		       ADC_CTL_SW_CH_ON);
+
+	/* the vendor waits up to 600 us */
+	for (i = 0; i < 20; i++) {
+		ret = sprd_adi_read(ADC_IRQ_RAW, &val);
+		if (ret || val)
+			break;
+		usleep_range(50, 100);
+	}
+	if (!ret && !val)
+		ret = -ETIMEDOUT;
+	if (!ret)
+		ret = sprd_adi_read(ADC_DAT, &val);
+	if (!ret)
+		*raw = val & 0xfff;
+	sprd_adi_write(ADC_CTL, ctl);
+out:
+	mutex_unlock(&adc->lock);
+	return ret;
+}
+
+static int sc2723_adc_read_raw(struct iio_dev *indio_dev,
+			       struct iio_chan_spec const *chan,
+			       int *val, int *val2, long mask)
+{
+	int ret;
+
+	if (mask != IIO_CHAN_INFO_RAW)
+		return -EINVAL;
+	ret = sc2723_adc_convert(iio_priv(indio_dev), chan->channel, val);
+	return ret ?: IIO_VAL_INT;
+}
+
+static const struct iio_info sc2723_adc_info = {
+	.read_raw = sc2723_adc_read_raw,
+};
+
+static int sc2723_adc_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct iio_chan_spec *chans;
+	struct iio_dev *indio_dev;
+	struct sc2723_adc *adc;
+	int i, ret;
+
+	indio_dev = devm_iio_device_alloc(dev, sizeof(*adc));
+	if (!indio_dev)
+		return -ENOMEM;
+	adc = iio_priv(indio_dev);
+	ret = devm_mutex_init(dev, &adc->lock);
+	if (ret)
+		return ret;
+
+	chans = devm_kcalloc(dev, SC2723_ADC_CHANNELS, sizeof(*chans),
+			     GFP_KERNEL);
+	if (!chans)
+		return -ENOMEM;
+	for (i = 0; i < SC2723_ADC_CHANNELS; i++) {
+		chans[i].type = IIO_VOLTAGE;
+		chans[i].indexed = 1;
+		chans[i].channel = i;
+		chans[i].info_mask_separate = BIT(IIO_CHAN_INFO_RAW);
+	}
+
+	/* module, its clocks and the crystal it samples with */
+	ret = sprd_adi_update(GLB_ARM_MODULE_EN, 0, GLB_ADC_EN);
+	if (!ret)
+		ret = sprd_adi_update(GLB_ARM_CLK_EN, 0, GLB_CLK_AUXADC_EN);
+	if (!ret)
+		ret = sprd_adi_update(GLB_XTL_WAIT_CTRL, 0, GLB_XTL_EN);
+	if (ret)
+		return dev_err_probe(dev, ret, "cannot enable the ADC\n");
+
+	indio_dev->name = "sc2723-adc";
+	indio_dev->info = &sc2723_adc_info;
+	indio_dev->modes = INDIO_DIRECT_MODE;
+	indio_dev->channels = chans;
+	indio_dev->num_channels = SC2723_ADC_CHANNELS;
+	return devm_iio_device_register(dev, indio_dev);
+}
+
+static const struct of_device_id sc2723_adc_of_match[] = {
+	{ .compatible = "sprd,sc2723-adc-polled" },
+	{ }
+};
+
+static struct platform_driver sc2723_adc_driver = {
+	.probe = sc2723_adc_probe,
+	.driver = {
+		.name = "sc2723-adc-polled",
+		.of_match_table = sc2723_adc_of_match,
+	},
+};
+builtin_platform_driver(sc2723_adc_driver);
diff --git a/arch/arm/mach-sprd/sc2723-fgu.c b/arch/arm/mach-sprd/sc2723-fgu.c
index dfe4fa210..6df13a84e 100644
--- a/arch/arm/mach-sprd/sc2723-fgu.c
+++ b/arch/arm/mach-sprd/sc2723-fgu.c
@@ -13,6 +13,11 @@
  * in the FGU's always-on USER_AREA, so a reboot continues from it instead
  * of a fresh estimate under load.
  *
+ * The battery thermistor is not wired to the charger but to the PMIC's
+ * auxiliary ADC. With an ADC channel and the vendor's table this reports
+ * the temperature and, like the vendor's sec-battery, stops charging
+ * outside a temperature window through the charger's charge_behaviour.
+ *
  * Register layout, eFuse decoding and formulas from the vendor 3.10 driver
  * (drivers/battery/sprd_2713_fgu.c, drivers/misc/sprd_otp/). Mainline
  * sc27xx_fuel_gauge has the same FGU block but needs a regmap parent, IIO
@@ -23,6 +28,7 @@
 #include <linux/bitfield.h>
 #include <linux/bitops.h>
 #include <linux/delay.h>
+#include <linux/iio/consumer.h>
 #include <linux/math64.h>
 #include <linux/mod_devicetable.h>
 #include <linux/platform_device.h>
@@ -79,6 +85,13 @@ struct sc2723_fgu {
 	int soc;		/* last reported capacity, % */
 	int status;
 	bool ready;		/* battery data loaded, polling may run */
+	struct iio_channel *temp_chan;
+	u32 *temp_table;	/* pairs: ADC counts rising, 0.1 C falling */
+	int temp_points;
+	int temp;		/* 0.1 C */
+	bool temp_limits;
+	int stop_lo, stop_hi, resume_lo, resume_hi;	/* 0.1 C */
+	bool inhibited;		/* charging stopped for the temperature */
 };
 
 static int fgu_read(u32 reg)
@@ -218,6 +231,62 @@ static bool sc2723_fgu_charger_full(struct sc2723_fgu *fgu)
 	       val.intval == POWER_SUPPLY_STATUS_FULL;
 }
 
+static int sc2723_fgu_read_temp(struct sc2723_fgu *fgu, int *temp)
+{
+	const u32 *t = fgu->temp_table;
+	int raw, i, ret;
+
+	ret = iio_read_channel_raw(fgu->temp_chan, &raw);
+	if (ret < 0)
+		return ret;
+
+	/* linear between the points, clamped at the ends */
+	if (raw <= t[0]) {
+		*temp = (s32)t[1];
+		return 0;
+	}
+	for (i = 1; i < fgu->temp_points; i++) {
+		int r0 = t[2 * i - 2], r1 = t[2 * i];
+		int c0 = (s32)t[2 * i - 1], c1 = (s32)t[2 * i + 1];
+
+		if (raw <= r1) {
+			*temp = c0 + (c1 - c0) * (raw - r0) / (r1 - r0);
+			return 0;
+		}
+	}
+	*temp = (s32)t[2 * fgu->temp_points - 1];
+	return 0;
+}
+
+static void sc2723_fgu_temp_limits(struct sc2723_fgu *fgu, int temp)
+{
+	union power_supply_propval val;
+	struct power_supply *charger;
+	bool inhibit = fgu->inhibited;
+
+	if (temp <= fgu->stop_lo || temp >= fgu->stop_hi)
+		inhibit = true;
+	else if (temp >= fgu->resume_lo && temp <= fgu->resume_hi)
+		inhibit = false;
+	if (inhibit == fgu->inhibited)
+		return;
+
+	charger = power_supply_get_by_reference(dev_fwnode(fgu->dev),
+						"power-supplies");
+	if (IS_ERR_OR_NULL(charger))
+		return;
+	val.intval = inhibit ? POWER_SUPPLY_CHARGE_BEHAVIOUR_INHIBIT_CHARGE :
+			       POWER_SUPPLY_CHARGE_BEHAVIOUR_AUTO;
+	if (!power_supply_set_property(charger,
+				       POWER_SUPPLY_PROP_CHARGE_BEHAVIOUR, &val)) {
+		fgu->inhibited = inhibit;
+		dev_warn(fgu->dev, "battery at %d.%d C, charging %s\n",
+			 temp / 10, abs(temp % 10),
+			 inhibit ? "stopped" : "allowed again");
+	}
+	power_supply_put(charger);
+}
+
 static void sc2723_fgu_update(struct sc2723_fgu *fgu)
 {
 	int volt = fgu_read(FGU_VOLT_VAL), curt = fgu_read(FGU_CURT_VAL);
@@ -266,6 +335,10 @@ static void sc2723_fgu_update(struct sc2723_fgu *fgu)
 	else
 		status = POWER_SUPPLY_STATUS_NOT_CHARGING;
 
+	if (fgu->temp_chan && !sc2723_fgu_read_temp(fgu, &fgu->temp) &&
+	    fgu->temp_limits)
+		sc2723_fgu_temp_limits(fgu, fgu->temp);
+
 	if (soc != fgu->soc)
 		sc2723_fgu_save(soc);
 	if (soc != fgu->soc || status != fgu->status) {
@@ -347,6 +420,22 @@ static int sc2723_fgu_get_property(struct power_supply *psy,
 	case POWER_SUPPLY_PROP_VOLTAGE_MAX_DESIGN:
 		val->intval = fgu->info->constant_charge_voltage_max_uv;
 		break;
+	case POWER_SUPPLY_PROP_TEMP:
+		if (!fgu->temp_chan)
+			return -ENODATA;
+		val->intval = fgu->temp;
+		break;
+	case POWER_SUPPLY_PROP_HEALTH:
+		if (!fgu->temp_chan || !fgu->temp_limits)
+			val->intval = POWER_SUPPLY_HEALTH_UNKNOWN;
+		else if (!fgu->inhibited && fgu->temp > fgu->stop_lo &&
+			 fgu->temp < fgu->stop_hi)
+			val->intval = POWER_SUPPLY_HEALTH_GOOD;
+		else if (fgu->temp > (fgu->resume_lo + fgu->resume_hi) / 2)
+			val->intval = POWER_SUPPLY_HEALTH_OVERHEAT;
+		else
+			val->intval = POWER_SUPPLY_HEALTH_COLD;
+		break;
 	default:
 		return -EINVAL;
 	}
@@ -374,6 +463,8 @@ static const enum power_supply_property sc2723_fgu_props[] = {
 	POWER_SUPPLY_PROP_CHARGE_FULL_DESIGN,
 	POWER_SUPPLY_PROP_VOLTAGE_MIN_DESIGN,
 	POWER_SUPPLY_PROP_VOLTAGE_MAX_DESIGN,
+	POWER_SUPPLY_PROP_TEMP,
+	POWER_SUPPLY_PROP_HEALTH,
 };
 
 static const struct power_supply_desc sc2723_fgu_desc = {
@@ -393,6 +484,46 @@ static void sc2723_fgu_stop(void *data)
 	cancel_delayed_work_sync(&fgu->work);
 }
 
+static int sc2723_fgu_probe_temp(struct sc2723_fgu *fgu)
+{
+	struct device *dev = fgu->dev;
+	s32 lim[2];
+	int n, ret;
+
+	fgu->temp_chan = devm_iio_channel_get(dev, "bat-temp");
+	if (IS_ERR(fgu->temp_chan)) {
+		ret = PTR_ERR(fgu->temp_chan);
+		fgu->temp_chan = NULL;
+		return ret == -ENODEV ? 0 :
+		       dev_err_probe(dev, ret, "no battery temperature\n");
+	}
+
+	n = device_property_count_u32(dev, "sprd,bat-temp-table");
+	if (n < 4 || n % 2)
+		return dev_err_probe(dev, -EINVAL, "bad sprd,bat-temp-table\n");
+	fgu->temp_table = devm_kcalloc(dev, n, sizeof(u32), GFP_KERNEL);
+	if (!fgu->temp_table)
+		return -ENOMEM;
+	ret = device_property_read_u32_array(dev, "sprd,bat-temp-table",
+					     fgu->temp_table, n);
+	if (ret)
+		return ret;
+	fgu->temp_points = n / 2;
+
+	if (device_property_read_u32_array(dev, "sprd,charge-stop-celsius",
+					   (u32 *)lim, 2))
+		return 0;
+	fgu->stop_lo = lim[0] * 10;
+	fgu->stop_hi = lim[1] * 10;
+	if (device_property_read_u32_array(dev, "sprd,charge-resume-celsius",
+					   (u32 *)lim, 2))
+		return 0;
+	fgu->resume_lo = lim[0] * 10;
+	fgu->resume_hi = lim[1] * 10;
+	fgu->temp_limits = true;
+	return 0;
+}
+
 static int sc2723_fgu_probe(struct platform_device *pdev)
 {
 	struct device *dev = &pdev->dev;
@@ -418,6 +549,13 @@ static int sc2723_fgu_probe(struct platform_device *pdev)
 				 &r_real);
 	sc2723_fgu_calibrate(fgu, r_real);
 
+	ret = sc2723_fgu_probe_temp(fgu);
+	if (ret)
+		return ret;
+	if (fgu->temp_chan && !sc2723_fgu_read_temp(fgu, &fgu->temp))
+		dev_info(dev, "battery %d.%d C\n", fgu->temp / 10,
+			 abs(fgu->temp % 10));
+
 	cfg.drv_data = fgu;
 	cfg.fwnode = dev_fwnode(dev);
 	fgu->psy = devm_power_supply_register(dev, &sc2723_fgu_desc, &cfg);

From a41c5802a6c5a3d566ed9a59e72253b391dada00 Mon Sep 17 00:00:00 2001
From: Deniz Kokden <koekdendeniz@gmail.com>
Date: Sun, 1 Nov 2026 19:24:06 +0000
Subject: [PATCH 014/110] usb: dwc2: drd: report the role in effect

The role switch has no .get callback, so the class reports the role it
cached on the last set, which is "none" until something sets one, even
though dwc2_ovr_init() already forced the session of
role-switch-default-mode. User space that trusts the reported role
(usb-signaller) then refuses to work on a peripheral-only controller
without VBUS sensing, whose role nobody ever sets.

Keep the role that dwc2_ovr_init() and dwc2_drd_role_sw_set() apply,
with "none" mapped to the default mode as the hardware is, and report it
from a .get callback. A connector that sets "none" now reads back the
default role, which is the one the controller runs in.

The role is cached instead of read back from GOTGCTL because
dwc2_drd_resume() restores the last role through
usb_role_switch_get_role() at a point where the session overrides may
have been lost with the power domain or cleared by dwc2_resume().

Fixes: e14acb876985 ("usb: dwc2: drd: add role-switch-default-node support")
Assisted-by: Claude Opus 5.5
---
 drivers/usb/dwc2/core.h |  4 ++++
 drivers/usb/dwc2/drd.c  | 19 ++++++++++++++++---
 2 files changed, 20 insertions(+), 3 deletions(-)

diff --git a/drivers/usb/dwc2/core.h b/drivers/usb/dwc2/core.h
index 015a5fb78..0d4552520 100644
--- a/drivers/usb/dwc2/core.h
+++ b/drivers/usb/dwc2/core.h
@@ -15,6 +15,7 @@
 #include <linux/usb/gadget.h>
 #include <linux/usb/otg.h>
 #include <linux/usb/phy.h>
+#include <linux/usb/role.h>
 #include "hw.h"
 
 /*
@@ -867,6 +868,8 @@ struct dwc2_hregs_backup {
  * @role_sw:		usb_role_switch handle
  * @role_sw_default_mode: default operation mode of controller while usb role
  *			is USB_ROLE_NONE
+ * @role_sw_role:	role last applied through the role switch, with
+ *			USB_ROLE_NONE already mapped to role_sw_default_mode
  * @hcd_enabled:	Host mode sub-driver initialization indicator.
  * @gadget_enabled:	Peripheral mode sub-driver initialization indicator.
  * @ll_hw_enabled:	Status of low-level hardware resources.
@@ -1065,6 +1068,7 @@ struct dwc2_hsotg {
 	enum usb_dr_mode dr_mode;
 	struct usb_role_switch *role_sw;
 	enum usb_dr_mode role_sw_default_mode;
+	enum usb_role role_sw_role;
 	unsigned int hcd_enabled:1;
 	unsigned int gadget_enabled:1;
 	unsigned int ll_hw_enabled:1;
diff --git a/drivers/usb/dwc2/drd.c b/drivers/usb/dwc2/drd.c
index 1ad8fa3f8..3a6557e81 100644
--- a/drivers/usb/dwc2/drd.c
+++ b/drivers/usb/dwc2/drd.c
@@ -27,10 +27,14 @@ static void dwc2_ovr_init(struct dwc2_hsotg *hsotg)
 	gotgctl = dwc2_readl(hsotg, GOTGCTL);
 	dwc2_ovr_gotgctl(gotgctl);
 	gotgctl &= ~(GOTGCTL_BVALOVAL | GOTGCTL_AVALOVAL | GOTGCTL_VBVALOVAL);
-	if (hsotg->role_sw_default_mode == USB_DR_MODE_HOST)
+	hsotg->role_sw_role = USB_ROLE_NONE;
+	if (hsotg->role_sw_default_mode == USB_DR_MODE_HOST) {
 		gotgctl |= GOTGCTL_AVALOVAL | GOTGCTL_VBVALOVAL;
-	else if (hsotg->role_sw_default_mode == USB_DR_MODE_PERIPHERAL)
+		hsotg->role_sw_role = USB_ROLE_HOST;
+	} else if (hsotg->role_sw_default_mode == USB_DR_MODE_PERIPHERAL) {
 		gotgctl |= GOTGCTL_BVALOVAL | GOTGCTL_VBVALOVAL;
+		hsotg->role_sw_role = USB_ROLE_DEVICE;
+	}
 	dwc2_writel(hsotg, gotgctl, GOTGCTL);
 
 	spin_unlock_irqrestore(&hsotg->lock, flags);
@@ -126,6 +130,7 @@ static int dwc2_drd_role_sw_set(struct usb_role_switch *sw, enum usb_role role)
 		else if (hsotg->role_sw_default_mode == USB_DR_MODE_PERIPHERAL)
 			role = USB_ROLE_DEVICE;
 	}
+	hsotg->role_sw_role = role;
 
 	if ((IS_ENABLED(CONFIG_USB_DWC2_PERIPHERAL) ||
 	     IS_ENABLED(CONFIG_USB_DWC2_DUAL_ROLE)) &&
@@ -170,6 +175,13 @@ static int dwc2_drd_role_sw_set(struct usb_role_switch *sw, enum usb_role role)
 	return 0;
 }
 
+static enum usb_role dwc2_drd_role_sw_get(struct usb_role_switch *sw)
+{
+	struct dwc2_hsotg *hsotg = usb_role_switch_get_drvdata(sw);
+
+	return hsotg->role_sw_role;
+}
+
 int dwc2_drd_init(struct dwc2_hsotg *hsotg)
 {
 	struct usb_role_switch_desc role_sw_desc = {0};
@@ -183,6 +195,7 @@ int dwc2_drd_init(struct dwc2_hsotg *hsotg)
 	role_sw_desc.driver_data = hsotg;
 	role_sw_desc.fwnode = dev_fwnode(hsotg->dev);
 	role_sw_desc.set = dwc2_drd_role_sw_set;
+	role_sw_desc.get = dwc2_drd_role_sw_get;
 	role_sw_desc.allow_userspace_control = true;
 
 	role_sw = usb_role_switch_register(hsotg->dev, &role_sw_desc);
@@ -220,7 +233,7 @@ void dwc2_drd_resume(struct dwc2_hsotg *hsotg)
 	enum usb_role role;
 
 	if (hsotg->role_sw) {
-		/* get last known role (as the get ops isn't implemented by this driver) */
+		/* last role applied, the registers may have lost it */
 		role = usb_role_switch_get_role(hsotg->role_sw);
 
 		if (role == USB_ROLE_NONE) {
-- 

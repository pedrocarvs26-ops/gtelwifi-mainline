From cf2eff0540b7d0ebe7738bf372c63d95fd443282 Mon Sep 17 00:00:00 2001
From: Deniz Kokden <koekdendeniz@gmail.com>
Date: Mon, 2 Nov 2026 08:34:01 +0000
Subject: [PATCH 041/109] ARM: sprd: SC2723 PMIC regmap and interrupt glue

Expose the SC2723 as a regmap over the ADI helpers, with its interrupt
controller (offset 0x380, GIC SPI 38) as a regmap-irq chip, and populate
the child nodes. This is what sprd-sc27xx-spi does for the SC2730/SC2731
over spi-sprd-adi, so the mainline sc27xx RTC and PMIC EIC drivers bind
unchanged: their register blocks match the SC2723 (vendor 3.10 drivers,
read back on the hardware). Allow both drivers with the glue.

The whole PMIC interrupt is a wakeup source in suspend, like in the
mainline MFD. The polled EIC glue for gpio-keys-polled goes away.

Assisted-by: Claude Opus 5.5
Signed-off-by: Deniz Kokden <koekdendeniz@gmail.com>
---
 arch/arm/Kconfig.platforms       |  24 +++---
 arch/arm/mach-sprd/Makefile      |   2 +-
 arch/arm/mach-sprd/pmic-eic.c    |  98 ----------------------
 arch/arm/mach-sprd/sc2723-pmic.c | 139 +++++++++++++++++++++++++++++++
 drivers/gpio/Kconfig             |   2 +-
 drivers/rtc/Kconfig              |   2 +-
 6 files changed, 155 insertions(+), 112 deletions(-)
 delete mode 100644 arch/arm/mach-sprd/pmic-eic.c
 create mode 100644 arch/arm/mach-sprd/sc2723-pmic.c

diff --git a/arch/arm/Kconfig.platforms b/arch/arm/Kconfig.platforms
index e79904294..96d134fe3 100644
--- a/arch/arm/Kconfig.platforms
+++ b/arch/arm/Kconfig.platforms
@@ -198,17 +198,6 @@ config SPRD_RESTART
 	  bootloader ("reboot recovery" boots the recovery partition) and
 	  lets the PMIC watchdog reset the system, as the vendor kernel does.
 
-config SPRD_PMIC_EIC
-	bool "SC2723 PMIC EIC inputs as polled GPIOs (bring-up glue)"
-	depends on ARCH_SPRD && GPIOLIB
-	select SPRD_ADI
-	help
-	  The power and volume down keys of SC7730 tablets hang off the
-	  EIC block of the SC2723 PMIC behind the ADI bus. This exposes
-	  its 16 inputs as a GPIO chip without interrupts, for
-	  gpio-keys-polled, until the mainline sc27xx drivers support
-	  the SC2723.
-
 config SPRD_CLK_AUX0
 	bool "SC7730 CLK_AUX0 32 kHz output (bring-up glue)"
 	depends on ARCH_SPRD && COMMON_CLK
@@ -234,6 +223,19 @@ config SPRD_SC2723_LDO
 	  set over the ADI bus: the microSD card supply, later the camera
 	  rails.
 
+config SPRD_SC2723_PMIC
+	bool "SC2723 PMIC regmap and interrupts (bring-up glue)"
+	depends on ARCH_SPRD && OF
+	select SPRD_ADI
+	select REGMAP
+	select REGMAP_IRQ
+	help
+	  The SC2723 PMIC as a regmap over the ADI bus, with its interrupt
+	  controller, for the mainline sc27xx RTC (RTC_DRV_SC27XX) and PMIC
+	  EIC (GPIO_PMIC_EIC_SPRD, power and volume down keys) drivers.
+	  Stand-in for spi-sprd-adi plus the sc27xx MFD, which do not know
+	  the SC7730/SC2723 yet.
+
 config SPRD_SC2723_ADC
 	bool "SC2723 PMIC auxiliary ADC (bring-up glue)"
 	depends on ARCH_SPRD && IIO

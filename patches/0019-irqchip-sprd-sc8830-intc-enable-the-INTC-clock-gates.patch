From 3c4ce159560574b4acf0abf51b144ac8befffffb Mon Sep 17 00:00:00 2001
From: Deniz Kokden <koekdendeniz@gmail.com>
Date: Sun, 1 Nov 2026 20:51:31 +0000
Subject: [PATCH 019/110] irqchip: sprd-sc8830-intc: enable the INTC clock
 gates itself

INTC0-3 are gated by AP APB EB bits 19-22. So far the timer driver
enabled them, but the irqchip initialises before the timers, and
writes into a gated block are lost. Map the gate register as optional
fifth region and enable the gates before touching the blocks.

Assisted-by: Claude Opus 5.5
Signed-off-by: Deniz Kokden <koekdendeniz@gmail.com>
---
 drivers/irqchip/irq-sprd-sc8830-intc.c | 12 ++++++++++++
 1 file changed, 12 insertions(+)

diff --git a/drivers/irqchip/irq-sprd-sc8830-intc.c b/drivers/irqchip/irq-sprd-sc8830-intc.c
index 8bca8a2db..94c95e617 100644
--- a/drivers/irqchip/irq-sprd-sc8830-intc.c
+++ b/drivers/irqchip/irq-sprd-sc8830-intc.c
@@ -13,6 +13,10 @@
  * the other way. INTC n covers SPI 32n..32n+31 with bit = SPI % 32; bits 0
  * and 1 of every block are not wired. The AON wake-up mux, which only
  * matters for deep sleep, is not handled.
+ *
+ * An optional fifth register region is the AP APB clock gate register:
+ * INTC0-3 are bits 19-22 there. They have to be on before the blocks take
+ * any write, and this runs before the timers that used to enable them.
  */
 
 #include <linux/bits.h>
@@ -30,6 +34,7 @@
 #define INTC_IRQ_EN		0x08
 #define INTC_IRQ_DIS		0x0c
 #define INTC_FIQ_DIS		0x2c
+#define AP_APB_EB_INTC0_3	GENMASK(22, 19)
 
 static void __iomem *intc_base[INTC_BLOCKS];
 
@@ -114,6 +119,7 @@ static int __init sc8830_intc_init(struct device_node *node,
 				   struct device_node *parent)
 {
 	struct irq_domain *parent_domain, *domain;
+	void __iomem *ap_apb;
 	int i;
 
 	parent_domain = parent ? irq_find_host(parent) : NULL;
@@ -122,6 +128,12 @@ static int __init sc8830_intc_init(struct device_node *node,
 		return -ENXIO;
 	}
 
+	ap_apb = of_iomap(node, INTC_BLOCKS);
+	if (ap_apb) {
+		writel_relaxed(readl_relaxed(ap_apb) | AP_APB_EB_INTC0_3, ap_apb);
+		iounmap(ap_apb);
+	}
+
 	for (i = 0; i < INTC_BLOCKS; i++) {
 		intc_base[i] = of_iomap(node, i);
 		if (!intc_base[i]) {
-- 

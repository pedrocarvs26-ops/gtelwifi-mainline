 arch/arm/Makefile                             |   1 +
 arch/arm/boot/dts/unisoc/Makefile             |   2 +
 .../dts/unisoc/sc7730-samsung-gtelwifi.dts    |  81 ++++++
 arch/arm/boot/dts/unisoc/sc7730.dtsi          |  75 +++++
 arch/arm/mach-sprd/Makefile                   |   2 +
 arch/arm/mach-sprd/bootstripes.c              | 111 ++++++++
 drivers/clocksource/Kconfig                   |   9 +
 drivers/clocksource/Makefile                  |   1 +
 drivers/clocksource/timer-sprd-sc8830.c       | 263 ++++++++++++++++++
 include/linux/sprd-bootstripes.h              |  28 ++
 init/main.c                                   |   9 +
 12 files changed, 602 insertions(+)
 create mode 100644 arch/arm/boot/dts/unisoc/sc7730-samsung-gtelwifi.dts
 create mode 100644 arch/arm/boot/dts/unisoc/sc7730.dtsi
 create mode 100644 arch/arm/mach-sprd/Makefile
 create mode 100644 arch/arm/mach-sprd/bootstripes.c
 create mode 100644 drivers/clocksource/timer-sprd-sc8830.c
 create mode 100644 include/linux/sprd-bootstripes.h

diff --git a/arch/arm/Kconfig.platforms b/arch/arm/Kconfig.platforms
index 2e118b65f..f0fb17015 100644
--- a/arch/arm/Kconfig.platforms
+++ b/arch/arm/Kconfig.platforms
@@ -159,6 +159,26 @@ config ARCH_RDA
 	help
 	  This enables support for the RDA Micro 8810PL SoC family.
 
+config ARCH_SPRD
+	bool "Spreadtrum/Unisoc 32-bit SoCs (SC7730/SC8830 \"shark\")"
+	depends on ARCH_MULTI_V7
+	select ARM_GIC
+	select HAVE_ARM_ARCH_TIMER
+	select SPRD_SC8830_TIMER
+	help
+	  Support for the 32-bit Spreadtrum SC7730/SC8830 ("scx35"/"shark")
+	  family, e.g. the Samsung Galaxy Tab E 9.6 (SM-T560, gtelwifi).
+
+config SPRD_BOOTSTRIPES
+	bool "Paint boot progress stripes into the bootloader framebuffer"
+	depends on ARCH_SPRD
+	help
+	  Debug aid for bring-up without a serial console. The Spreadtrum
+	  bootloader passes the scan-out buffer of its splash screen as
+	  "lcd_base=<hex>" on the command line. With this option the kernel
+	  reserves that buffer and paints a white band for every boot stage
+	  it reaches, so a photo of the screen shows where boot stopped.
+
 menuconfig ARCH_SUNPLUS
 	bool "Sunplus SoCs"
 	depends on ARCH_MULTI_V7

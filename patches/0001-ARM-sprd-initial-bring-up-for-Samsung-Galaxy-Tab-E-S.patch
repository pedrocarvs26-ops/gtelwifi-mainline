diff --git a/arch/arm/boot/dts/unisoc/sc7730-samsung-gtelwifi.dts b/arch/arm/boot/dts/unisoc/sc7730-samsung-gtelwifi.dts
new file mode 100644
index 000000000..491e0e7f9
--- /dev/null
+++ b/arch/arm/boot/dts/unisoc/sc7730-samsung-gtelwifi.dts
@@ -0,0 +1,81 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Samsung Galaxy Tab E 9.6 WiFi (SM-T560, "gtelwifi")
+ *
+ * Panel: Novatek NT51017 (BOE), 800x1280 MIPI DSI video mode, native
+ * portrait. Touch: Zinitix ZT7554 on I2C. Charger: SMB358.
+ */
+
+/dts-v1/;
+
+#include "sc7730.dtsi"
+
+/ {
+	model = "Samsung Galaxy Tab E 9.6 (SM-T560)";
+	compatible = "samsung,gtelwifi", "sprd,sc7730";
+
+	/*
+	 * Board id the Spreadtrum bootloader matches against dt.img.
+	 * The build script generates one copy per hardware revision.
+	 */
+	sprd,sc-id = <8830 11 0x20000>;
+
+	aliases {
+		serial1 = &uart1;
+	};
+
+	chosen {
+		/* The bootloader rewrites this, the kernel appends its own */
+		bootargs = "";
+	};
+
+	/* The bootloader patches the real size in */
+	memory@80000000 {
+		device_type = "memory";
+		reg = <0x80000000 0x60000000>;
+	};
+
+	reserved-memory {
+		#address-cells = <1>;
+		#size-cells = <1>;
+		ranges;
+
+		smem@87800000 {
+			reg = <0x87800000 0x240000>;
+			no-map;
+		};
+
+		cp-modem@88000000 {
+			reg = <0x88000000 0x1c00000>;
+			no-map;
+		};
+
+		/* vendor kernel framebuffer, also our fallback scan-out */
+		framebuffer@9ea44000 {
+			reg = <0x9ea44000 0xbb8000>;
+			no-map;
+		};
+
+		/*
+		 * Kernel log survives a warm reboot here. Lies inside the area
+		 * the vendor kernel reserves for ION, so TWRP will not touch it.
+		 */
+		ramoops@9fc00000 {
+			compatible = "ramoops";
+			reg = <0x9fc00000 0x100000>;
+			record-size = <0x20000>;
+			console-size = <0x40000>;
+			pmsg-size = <0x20000>;
+		};
+	};
+
+	/* Scan-out buffer left running by the bootloader (if lcd_base matches) */
+	framebuffer@9ea44000 {
+		compatible = "simple-framebuffer";
+		reg = <0x9ea44000 (800 * 1280 * 4)>;
+		width = <800>;
+		height = <1280>;
+		stride = <(800 * 4)>;
+		format = "x8r8g8b8";	/* channel order still unverified */
+	};
+};
diff --git a/arch/arm/boot/dts/unisoc/sc7730.dtsi b/arch/arm/boot/dts/unisoc/sc7730.dtsi
new file mode 100644
index 000000000..20dafec65
--- /dev/null
+++ b/arch/arm/boot/dts/unisoc/sc7730.dtsi
@@ -0,0 +1,75 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Spreadtrum SC7730 ("scx35", "shark") SoC, 4x Cortex-A7, Mali-400 MP2.
+ *
+ * Addresses are physical and come from the vendor 3.10 kernel
+ * (arch/arm/mach-sc/include/mach/__hardware-sc8830.h). The vendor
+ * device tree uses static virtual mappings (0xf5xxxxxx), translated here.
+ *
+ * Only what is needed for a first mainline boot is described: one CPU,
+ * GIC, timer, UART. Everything else is still set up by the bootloader.
+ */
+
+#include <dt-bindings/interrupt-controller/arm-gic.h>
+
+/ {
+	#address-cells = <1>;
+	#size-cells = <1>;
+	interrupt-parent = <&gic>;
+
+	cpus {
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		/* Secondary CPUs need the Spreadtrum holding-pen, not yet */
+		cpu0: cpu@f00 {
+			device_type = "cpu";
+			compatible = "arm,cortex-a7";
+			reg = <0xf00>;
+		};
+	};
+
+	ext_26m: clock-26m {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <26000000>;
+		clock-output-names = "ext-26m";
+	};
+
+	soc {
+		compatible = "simple-bus";
+		#address-cells = <1>;
+		#size-cells = <1>;
+		ranges;
+
+		gic: interrupt-controller@12001000 {
+			compatible = "arm,cortex-a7-gic";
+			#interrupt-cells = <3>;
+			interrupt-controller;
+			reg = <0x12001000 0x1000>,
+			      <0x12002000 0x2000>;
+		};
+
+		timer@40050000 {
+			compatible = "sprd,sc8830-timer";
+			reg = <0x40050000 0x60>,	/* AON timer block */
+			      <0x402e0000 0x10>,	/* AON APB clock gates */
+			      <0x71300000 0x10>,	/* AP APB clock gates */
+			      <0x71400000 0x20>,	/* INTC0 */
+			      <0x40200000 0x20>;	/* wake-up mux */
+			reg-names = "timer", "aon-apb", "ap-apb", "intc", "intmux";
+			interrupts = <GIC_SPI 28 IRQ_TYPE_LEVEL_HIGH>;
+			clock-frequency = <32768>;
+			sprd,intmux-bit = <2>;
+		};
+
+		uart1: serial@70100000 {
+			compatible = "sprd,sc9836-uart";
+			reg = <0x70100000 0x100>;
+			interrupts = <GIC_SPI 3 IRQ_TYPE_LEVEL_HIGH>;
+			clocks = <&ext_26m>;
+			clock-names = "uart";
+			status = "disabled";
+		};
+	};
+};

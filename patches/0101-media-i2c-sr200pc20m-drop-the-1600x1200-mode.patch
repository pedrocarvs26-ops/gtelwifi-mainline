From 6faf2272ecdb0e5cb945a57f0f905e3b39ac4f8d Mon Sep 17 00:00:00 2001
From: Deniz Kokden <koekdendeniz@gmail.com>
Date: Thu, 5 Nov 2026 11:42:23 +0000
Subject: [PATCH 101/109] media: i2c: sr200pc20m: drop the 1600x1200 mode

The UXGA table runs at about 8 fps and only makes sense for stills, but
there is no capture path that switches the sensor into it for a single
shot. Offering it as an ordinary mode made the Android camera HAL
(libcamera) pair a 640x480 preview with a 1600x1200 JPEG, two streams
the DCAM cannot produce at once, and the camera failed to open. Keep
640x480 only, as the preview modes of the S5K4ECGX are kept to 800x480.

Assisted-by: Claude Opus 5.5
---
 drivers/media/i2c/sr200pc20m.c | 6 ++++--
 1 file changed, 4 insertions(+), 2 deletions(-)

diff --git a/drivers/media/i2c/sr200pc20m.c b/drivers/media/i2c/sr200pc20m.c
index 2dbede3d4..8d52a4aba 100644
--- a/drivers/media/i2c/sr200pc20m.c
+++ b/drivers/media/i2c/sr200pc20m.c
@@ -65,12 +65,14 @@ static const s64 sr200_link_freqs[] = { 96000000, 144000000, 192000000 };
 /*
  * The first mode is the default, which camera applications tend to keep
  * for the preview. The HAL's 800x600 table runs at 8 fps, so it is left
- * out; 640x480 runs at 24 fps.
+ * out; 640x480 runs at 24 fps. So is 1600x1200 (UXGA, ~8 fps): a capture
+ * path that switches modes for stills does not exist yet, and offering it
+ * made the Android camera HAL pair a 640x480 preview with a 1600x1200 JPEG,
+ * two streams the DCAM cannot produce at once.
  */
 static const struct sr200_mode sr200_modes[] = {
 	/* the HAL's 640x480 table is a complete init of its own */
 	{ 640, 480, "sr200pc20m/640x480.bin", false, 1 },
-	{ 1600, 1200, "sr200pc20m/1600x1200.bin", true, 2 },
 };
 
 static const char * const sr200_supplies[] = { "avdd", "dovdd" };

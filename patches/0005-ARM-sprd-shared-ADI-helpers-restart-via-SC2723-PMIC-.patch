 arch/arm/mach-sprd/Makefile      |   2 +
 arch/arm/mach-sprd/adi.c         | 123 +++++++++++++++++++++++++++++++
 arch/arm/mach-sprd/adi.h         |  19 +++++
 arch/arm/mach-sprd/restart.c     | 115 +++++++++++++++++++++++++++++
 arch/arm/mach-sprd/usb-bringup.c |  63 +++-------------

From 51caf7f148b72d855e87a4cef5b7dad8c192abd0 Mon Sep 17 00:00:00 2001
From: Deniz Kokden <koekdendeniz@gmail.com>
Date: Mon, 2 Nov 2026 20:41:27 +0000
Subject: [PATCH 079/109] ASoC: sprd: sc7730 VBC: keep the digital DACs on
 between streams

The analog path behind the DACs stays powered after a stream for
pmdown_time, on the gtelwifi indefinitely to avoid the speaker amplifier
pop. With the digital DACs switched off on every stop, the analog DACs
had no running sigma-delta modulator in front of them, and the speaker
played a whine whenever the system was busy (camera preview) until the
next sound.

Leave the digital DACs enabled once a stream has started and switch them
off on system suspend, when the analog path goes down too.

Assisted-by: Claude Opus 5.5
Signed-off-by: Deniz Kokden <koekdendeniz@gmail.com>
---
 sound/soc/sprd/sprd-vbc-sc7730.c | 17 ++++++++++++++++-
 1 file changed, 16 insertions(+), 1 deletion(-)

diff --git a/sound/soc/sprd/sprd-vbc-sc7730.c b/sound/soc/sprd/sprd-vbc-sc7730.c
index f60dcc507..1c1084ea2 100644
--- a/sound/soc/sprd/sprd-vbc-sc7730.c
+++ b/sound/soc/sprd/sprd-vbc-sc7730.c
@@ -193,10 +193,16 @@ static int sprd_vbc_trigger(struct snd_pcm_substream *substream, int cmd,
 	case SNDRV_PCM_TRIGGER_STOP:
 	case SNDRV_PCM_TRIGGER_SUSPEND:
 	case SNDRV_PCM_TRIGGER_PAUSE_PUSH:
+		/*
+		 * The digital DACs stay on: the analog path behind them can
+		 * stay powered between streams (pmdown_time), and an analog
+		 * DAC without a running sigma-delta modulator picks up noise
+		 * that the speaker amplifier makes audible. They go off with
+		 * the system suspend, like the analog path.
+		 */
 		sprd_vbc_rmw(v->vbc + VBDABUFFDTA, VBENABLE | DA0_DMA_EN |
 			     DA1_DMA_EN, 0);
 		sprd_vbc_rmw(v->vbc + VBCHNEN, DA0_CHN_EN | DA1_CHN_EN, 0);
-		sprd_vbc_rmw(v->dp + AUD_TOP_CTL, DAC_EN_L | DAC_EN_R, 0);
 		break;
 	default:
 		return -EINVAL;
@@ -224,8 +230,17 @@ static struct snd_soc_dai_driver sprd_vbc_dai = {
 	.ops = &sprd_vbc_dai_ops,
 };
 
+static int sprd_vbc_suspend(struct snd_soc_component *component)
+{
+	struct sprd_vbc *v = snd_soc_component_get_drvdata(component);
+
+	sprd_vbc_rmw(v->dp + AUD_TOP_CTL, DAC_EN_L | DAC_EN_R, 0);
+	return 0;
+}
+
 static const struct snd_soc_component_driver sprd_vbc_component = {
 	.name = "sprd-vbc-sc7730",
+	.suspend = sprd_vbc_suspend,
 	.legacy_dai_naming = 1,
 };
 

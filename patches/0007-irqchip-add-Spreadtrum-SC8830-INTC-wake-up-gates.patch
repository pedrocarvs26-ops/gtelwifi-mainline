From 5a931eadf1b5d776829c53a7fc07c5b452d29a64 Mon Sep 17 00:00:00 2001
From: Deniz Kokden <koekdendeniz@gmail.com>
Date: Sun, 1 Nov 2026 15:53:21 +0000
Subject: [PATCH 007/109] irqchip: add Spreadtrum SC8830 INTC wake-up gates

Once all cores are in WFI the GIC clock on SC8830/SC7730 stops and only
interrupts enabled in one of the four INTC blocks wake the CPU. They still
reach the GIC without it, but each waits for the next timer tick: eMMC
reads were stuck at 0.6 MB/s (4 KiB) and 6 MB/s (64 KiB), USB network
latency at ~110 ms.

Stack a small hierarchical irqchip on the GIC that opens the INTC bit on
unmask, and route every SPI through it. eMMC reads now reach 18 / 31 MB/s,
USB latency drops to 0.8 ms.

Assisted-by: Claude Opus 5.5
Signed-off-by: Deniz Kokden <koekdendeniz@gmail.com>
---
 arch/arm/Kconfig.platforms             |   1 +
 arch/arm/boot/dts/unisoc/sc7730.dtsi   |  16 ++-
 drivers/irqchip/Kconfig                |   8 ++
 drivers/irqchip/Makefile               |   1 +
 drivers/irqchip/irq-sprd-sc8830-intc.c | 150 +++++++++++++++++++++++++
 5 files changed, 175 insertions(+), 1 deletion(-)
 create mode 100644 drivers/irqchip/irq-sprd-sc8830-intc.c

diff --git a/arch/arm/Kconfig.platforms b/arch/arm/Kconfig.platforms
index 4cec93c89..cc273644d 100644
--- a/arch/arm/Kconfig.platforms
+++ b/arch/arm/Kconfig.platforms
@@ -164,6 +164,7 @@ config ARCH_SPRD
 	depends on ARCH_MULTI_V7
 	select ARM_GIC
 	select HAVE_ARM_ARCH_TIMER
+	select SPRD_SC8830_INTC
 	select SPRD_SC8830_TIMER
 	help
 	  Support for the 32-bit Spreadtrum SC7730/SC8830 ("scx35"/"shark")
diff --git a/arch/arm/boot/dts/unisoc/sc7730.dtsi b/arch/arm/boot/dts/unisoc/sc7730.dtsi
index 5a5260fd6..68e359579 100644
--- a/arch/arm/boot/dts/unisoc/sc7730.dtsi
+++ b/arch/arm/boot/dts/unisoc/sc7730.dtsi
@@ -15,7 +15,7 @@
 / {
 	#address-cells = <1>;
 	#size-cells = <1>;
-	interrupt-parent = <&gic>;
+	interrupt-parent = <&intc>;
 
 	cpus {
 		#address-cells = <1>;
@@ -46,10 +46,24 @@ gic: interrupt-controller@12001000 {
 			compatible = "arm,cortex-a7-gic";
 			#interrupt-cells = <3>;
 			interrupt-controller;
+			interrupt-parent = <&gic>;
 			reg = <0x12001000 0x1000>,
 			      <0x12002000 0x2000>;
 		};
 
+		/*
+		 * Wake-up gates in front of the GIC: an idle CPU only wakes
+		 * for interrupts enabled here. All SPIs go through it.
+		 */
+		intc: interrupt-controller@71400000 {
+			compatible = "sprd,sc8830-intc";
+			#interrupt-cells = <3>;
+			interrupt-controller;
+			interrupt-parent = <&gic>;
+			reg = <0x71400000 0x1000>, <0x71500000 0x1000>,
+			      <0x71600000 0x1000>, <0x71700000 0x1000>;
+		};
+
 		timer@40050000 {
 			compatible = "sprd,sc8830-timer";
 			reg = <0x40050000 0x60>,	/* AON timer block */
diff --git a/drivers/irqchip/Kconfig b/drivers/irqchip/Kconfig
index 136bab41f..8f007ec69 100644
--- a/drivers/irqchip/Kconfig
+++ b/drivers/irqchip/Kconfig
@@ -435,6 +435,14 @@ config IMX_GPCV2
 	help
 	  Enables the wakeup IRQs for IMX platforms with GPCv2 block
 
+config SPRD_SC8830_INTC
+	bool
+	select IRQ_DOMAIN_HIERARCHY
+	help
+	  Wake-up gates (INTC0-3) in front of the GIC on Spreadtrum
+	  SC8830/SC7730 SoCs. Without them an idle CPU only notices
+	  interrupts at the next timer tick.
+
 config IRQ_MXS
 	def_bool y if MACH_ASM9260 || ARCH_MXS
 	select IRQ_DOMAIN

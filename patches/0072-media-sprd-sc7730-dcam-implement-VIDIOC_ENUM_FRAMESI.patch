From b7349da1c6a080f848e1cf74c1a72596ed4d77c8 Mon Sep 17 00:00:00 2001
From: Deniz Kokden <koekdendeniz@gmail.com>
Date: Mon, 2 Nov 2026 16:16:36 +0000
Subject: [PATCH 072/109] media: sprd: sc7730-dcam: implement
 VIDIOC_ENUM_FRAMESIZES

libcamera enumerates the frame sizes of each pixel format on the video
node and drops the format when that fails, so its simple pipeline
handler found no configuration ("Unable to enumerate frame sizes").
Report the stepwise range that S_FMT accepts: 16 to 2048 pixels wide in
steps of 4, 16 to 4092 lines in steps of 2.

Assisted-by: Claude Opus 5.5
Signed-off-by: Deniz Kokden <koekdendeniz@gmail.com>
---
 drivers/media/platform/sprd/sc7730-dcam.c | 17 +++++++++++++++++
 1 file changed, 17 insertions(+)

diff --git a/drivers/media/platform/sprd/sc7730-dcam.c b/drivers/media/platform/sprd/sc7730-dcam.c
index 6f5dc3dc5..d8c954be6 100644
--- a/drivers/media/platform/sprd/sc7730-dcam.c
+++ b/drivers/media/platform/sprd/sc7730-dcam.c
@@ -755,6 +755,22 @@ static int dcam_enum_fmt(struct file *file, void *priv,
 	return 0;
 }
 
+static int dcam_enum_framesizes(struct file *file, void *priv,
+				struct v4l2_frmsizeenum *fsize)
+{
+	if (fsize->index || fsize->pixel_format != V4L2_PIX_FMT_NV16)
+		return -EINVAL;
+	/* as dcam_fill_fmt() aligns them */
+	fsize->type = V4L2_FRMSIZE_TYPE_STEPWISE;
+	fsize->stepwise.min_width = 16;
+	fsize->stepwise.max_width = DCAM_MAX_WIDTH;
+	fsize->stepwise.step_width = 4;
+	fsize->stepwise.min_height = 16;
+	fsize->stepwise.max_height = DCAM_MAX_HEIGHT;
+	fsize->stepwise.step_height = 2;
+	return 0;
+}
+
 static int dcam_g_fmt(struct file *file, void *priv, struct v4l2_format *f)
 {
 	struct dcam *d = video_drvdata(file);
@@ -804,6 +820,7 @@ static int dcam_s_input(struct file *file, void *priv, unsigned int i)
 static const struct v4l2_ioctl_ops dcam_ioctl_ops = {
 	.vidioc_querycap = dcam_querycap,
 	.vidioc_enum_fmt_vid_cap = dcam_enum_fmt,
+	.vidioc_enum_framesizes = dcam_enum_framesizes,
 	.vidioc_g_fmt_vid_cap = dcam_g_fmt,
 	.vidioc_try_fmt_vid_cap = dcam_try_fmt,
 	.vidioc_s_fmt_vid_cap = dcam_s_fmt,

diff --git a/Documentation/devicetree/bindings/i2c/sprd,sc8830-i2c.yaml b/Documentation/devicetree/bindings/i2c/sprd,sc8830-i2c.yaml
new file mode 100644
index 000000000..a14af82ae
--- /dev/null
+++ b/Documentation/devicetree/bindings/i2c/sprd,sc8830-i2c.yaml
@@ -0,0 +1,99 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/i2c/sprd,sc8830-i2c.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Spreadtrum SC8830/SC7730 I2C controller
+
+maintainers:
+  - Deniz Kokden <koekdendeniz@gmail.com>
+
+description: |
+  I2C controllers of the SC7730 and the other SoCs of the SC8830 ("shark")
+  family. Each START, data byte and STOP is issued through a command
+  register; there is no FIFO. The SCL rate is derived from the source
+  clock with a divider (rate / (4 * (divider + 1))). Not compatible with
+  the FIFO based controller of the SC9860 (sprd,sc9860-i2c).
+
+  Clock gate and soft reset of each controller are one bit in the AP APB
+  clock enable register (EB, offset 0x0) and the same bit in the AP APB
+  reset register (RST, offset 0x4): bits 8 to 12 for I2C0 to I2C4. These
+  registers are shared with other AP APB peripherals; the optional
+  "ap-apb" region points there and sprd,ap-apb-bit names the bit.
+
+properties:
+  compatible:
+    const: sprd,sc8830-i2c
+
+  reg:
+    minItems: 1
+    items:
+      - description: Controller registers
+      - description: AP APB clock enable and reset registers
+
+  reg-names:
+    minItems: 1
+    items:
+      - const: i2c
+      - const: ap-apb
+
+  interrupts:
+    maxItems: 1
+
+  clocks:
+    maxItems: 1
+    description: Source clock of the controller, typically 26 MHz
+
+  clock-frequency:
+    default: 100000
+
+  sprd,ap-apb-bit:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    maximum: 31
+    description:
+      Bit of this controller in the AP APB clock enable and reset
+      registers.
+
+required:
+  - compatible
+  - reg
+  - reg-names
+  - clocks
+
+allOf:
+  - $ref: /schemas/i2c/i2c-controller.yaml#
+  - if:
+      properties:
+        reg-names:
+          contains:
+            const: ap-apb
+    then:
+      required:
+        - sprd,ap-apb-bit
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    i2c@70600000 {
+        compatible = "sprd,sc8830-i2c";
+        reg = <0x70600000 0x1000>, <0x71300000 0x8>;
+        reg-names = "i2c", "ap-apb";
+        sprd,ap-apb-bit = <9>;
+        clocks = <&ext_26m>;
+        clock-frequency = <100000>;
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        touchscreen@20 {
+            compatible = "zinitix,bt554";
+            reg = <0x20>;
+            interrupt-parent = <&gpio>;

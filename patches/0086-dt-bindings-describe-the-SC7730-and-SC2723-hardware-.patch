+
+  reset-gpios:
+    maxItems: 1
+    description: Reset input, active low
+
+  powerdown-gpios:
+    maxItems: 1
+    description: Standby input, active low
+
+  orientation: true
+
+  rotation: true
+
+  port:
+    $ref: /schemas/graph.yaml#/$defs/port-base
+    additionalProperties: false
+

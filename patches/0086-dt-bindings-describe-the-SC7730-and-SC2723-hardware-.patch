--- /dev/null
+++ b/Documentation/devicetree/bindings/timer/sprd,sc8830-timer.yaml
@@ -0,0 +1,68 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/timer/sprd,sc8830-timer.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Spreadtrum SC8830/SC7730 general purpose timer
+
+maintainers:
+  - Deniz Kokden <koekdendeniz@gmail.com>
+
+description: |
+  32-bit timer blocks of the SC7730 and the other SoCs of the SC8830
+  ("shark") family, one in the always-on (AON) domain and three in the AP
+  domain. Each block has three down-counting channels 0x20 apart, with
+  load, value, control, interrupt and shadow counter registers, and one
+  interrupt line. The AON block runs from the 32.768 kHz clock.
+
+  Unlike the 64-bit timers of the SC9860 (sprd,sc9860-timer) the counters
+  are 32 bits wide and the register layout differs.
+
+  The clock gates of the timers are bits in the AON APB clock enable
+  register EB0 (AON timer bit 11, AP timer 0 bit 12, system counter bit
+  10), which is shared with other AON peripherals; the optional "aon-apb"
+  region points there.
+
+properties:
+  compatible:
+    const: sprd,sc8830-timer
+
+  reg:
+    minItems: 1
+    items:
+      - description: Timer block (three channels)
+      - description: AON APB clock enable registers
+
+  reg-names:
+    minItems: 1
+    items:
+      - const: timer
+      - const: aon-apb
+
+  interrupts:
+    maxItems: 1
+
+  clock-frequency:
+    description: Rate of the timer clock in Hz.
+    default: 32768
+
+required:
+  - compatible
+  - reg
+  - interrupts
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/interrupt-controller/arm-gic.h>
+
+    timer@40050000 {
+        compatible = "sprd,sc8830-timer";
+        reg = <0x40050000 0x60>, <0x402e0000 0x10>;
+        reg-names = "timer", "aon-apb";
+        interrupts = <GIC_SPI 28 IRQ_TYPE_LEVEL_HIGH>;
+        clock-frequency = <32768>;
+    };
+...

new file mode 100644
index 000000000..c3d816319
--- /dev/null
+++ b/Documentation/devicetree/bindings/clock/sprd,sc7730-gates.yaml
@@ -0,0 +1,52 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/clock/sprd,sc7730-gates.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Spreadtrum SC7730 clock enable register
+
+maintainers:
+  - Deniz Kokden <koekdendeniz@gmail.com>
+
+description: |
+  A 32-bit register of clock enable bits on the SC7730, one bit per
+  peripheral, such as the AP AHB enable register at 0x20d00000 (for
+  example bit 4 USB, bit 5 DMA, bits 8 and 9 SDIO0 and SDIO1) or the AP APB
+  enable register at 0x71300000 (bits 8 to 12 I2C0 to I2C4, bits 13 to 17
+  UART0 to UART4, bits 19 to 22 the INTC blocks). Each bit gates the
+  clock of one peripheral; set means running.
+
+  The clock specifier is the bit number. All gates have the parent clock
+  given in "clocks" as reference; the actual bus clocks are not modelled.
+
+properties:
+  compatible:
+    const: sprd,sc7730-gates
+
+  reg:
+    maxItems: 1
+
+  clocks:
+    maxItems: 1
+
+  '#clock-cells':
+    const: 1
+
+required:
+  - compatible
+  - reg
+  - clocks
+  - '#clock-cells'
+
+additionalProperties: false
+
+examples:
+  - |
+    clock-controller@71300000 {
+        compatible = "sprd,sc7730-gates";
+        reg = <0x71300000 0x4>;
+        clocks = <&ext_26m>;
+        #clock-cells = <1>;
+    };
+...

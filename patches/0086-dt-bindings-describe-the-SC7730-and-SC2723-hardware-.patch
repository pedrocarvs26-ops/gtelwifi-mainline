@@ -0,0 +1,151 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/media/sprd,sc7730-dcam.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Spreadtrum SC7730 camera capture (DCAM and CSI-2 receiver)
+
+maintainers:
+  - Deniz Kokden <koekdendeniz@gmail.com>
+
+description: |
+  Camera capture of the SC7730 and the other SoCs of the SC8830 ("shark")
+  family: a Synopsys DesignWare MIPI CSI-2 host (version 1.03) with two
+  D-PHYs, D-PHY A with up to two data lanes and D-PHY C with one, and the
+  DCAM capture engine, which writes the received frames to memory (YUV
+  4:2:0 or 4:2:2 semi-planar, optionally scaled). Only one D-PHY receives
+  at a time.
+
+  The block sits in the MM power domain. Its bus gates, resets and the
+  CSI-2 D-PHY selection are bits in the MM AHB registers, its clocks
+  (including the master clock MCLK for the image sensors, 24 MHz) are set
+  in the MM clock registers, and the power-down bit of D-PHY A is in the
+  AON APB power control register. All three register blocks are shared
+  with other blocks.
+
+properties:
+  compatible:
+    const: sprd,sc7730-dcam
+
+  reg:
+    items:
+      - description: DCAM registers
+      - description: CSI-2 host registers
+      - description: MM AHB registers (bus gates and resets)
+      - description: MM clock configuration registers
+      - description: AON APB registers
+
+  reg-names:
+    items:
+      - const: dcam
+      - const: csi
+      - const: mm-ahb
+      - const: mm-clk
+      - const: aon-apb
+
+  interrupts:
+    maxItems: 1
+
+  power-domains:
+    maxItems: 1
+
+  '#clock-cells':
+    const: 0
+    description: The sensor master clock output (MCLK).
+
+  ports:
+    $ref: /schemas/graph.yaml#/properties/ports
+
+    properties:
+      port@0:
+        $ref: /schemas/graph.yaml#/$defs/port-base
+        unevaluatedProperties: false
+        description: CSI-2 input on D-PHY A
+
+        properties:
+          endpoint:
+            $ref: video-interfaces.yaml#
+            unevaluatedProperties: false
+
+            properties:
+              data-lanes:
+                minItems: 1
+                items:
+                  - const: 1
+                  - const: 2
+
+            required:
+              - data-lanes
+
+      port@1:
+        $ref: /schemas/graph.yaml#/$defs/port-base
+        unevaluatedProperties: false
+        description: CSI-2 input on D-PHY C
+
+        properties:
+          endpoint:
+            $ref: video-interfaces.yaml#
+            unevaluatedProperties: false
+
+            properties:
+              data-lanes:
+                items:
+                  - const: 1
+
+            required:
+              - data-lanes
+
+    required:
+      - port@0
+      - port@1
+
+required:
+  - compatible
+  - reg
+  - reg-names
+  - interrupts
+  - power-domains
+  - '#clock-cells'
+  - ports
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/interrupt-controller/arm-gic.h>
+
+    camera@60800000 {
+        compatible = "sprd,sc7730-dcam";
+        reg = <0x60800000 0x1000>, <0x60c00000 0x1000>,
+              <0x60d00000 0x100>, <0x60e00000 0x100>,
+              <0x402e0000 0x100>;
+        reg-names = "dcam", "csi", "mm-ahb", "mm-clk", "aon-apb";
+        interrupts = <GIC_SPI 45 IRQ_TYPE_LEVEL_HIGH>;
+        power-domains = <&pmu_domains 1>;
+        #clock-cells = <0>;
+
+        ports {
+            #address-cells = <1>;
+            #size-cells = <0>;
+
+            port@0 {
+                reg = <0>;
+
+                endpoint {
+                    remote-endpoint = <&rear_camera_out>;
+                    data-lanes = <1 2>;
+                };
+            };
+
+            port@1 {
+                reg = <1>;
+
+                endpoint {
+                    remote-endpoint = <&front_camera_out>;
+                    data-lanes = <1>;
+                };
+            };
+        };
+    };
+...
diff --git a/Documentation/devicetree/bindings/mfd/sprd,sc2723-adi-pmic.yaml b/Documentation/devicetree/bindings/mfd/sprd,sc2723-adi-pmic.yaml
new file mode 100644
index 000000000..1fe7f50b1
--- /dev/null
+++ b/Documentation/devicetree/bindings/mfd/sprd,sc2723-adi-pmic.yaml
@@ -0,0 +1,111 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/mfd/sprd,sc2723-adi-pmic.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Spreadtrum SC2723 PMIC on the SC7730 ADI bus
+
+maintainers:
+  - Deniz Kokden <koekdendeniz@gmail.com>
+
+description: |
+  The SC2723 companion PMIC of the SC7730/SC8830 SoCs, reached through the
+  SoC's analog-digital interface (ADI) at 0x40030000, whose software
+  channel maps the PMIC registers to 0x40038000 and up. This node stands
+  for the PMIC as seen through that fixed window; its children are the
+  PMIC functions, with their register offset in the PMIC as unit address.
+
+  The PMIC interrupt controller (ANA_INT, at offset 0x380) combines the
+  interrupts of the PMIC functions into one SoC interrupt. Its sources -
+    0 - auxiliary ADC
+    1 - GPIO
+    2 - RTC
+    3 - watchdog
+    4 - fuel gauge
+    5 - EIC (power key, external reset input and other inputs)
+    6 - headset button
+    7 - audio protection
+    8 - calibration
+    9 - thermal protection (TPC)
+    10 - DCDC over temperature
+
+properties:
+  compatible:
+    const: sprd,sc2723-adi-pmic
+
+  interrupts:
+    maxItems: 1
+
+  interrupt-controller: true
+
+  '#interrupt-cells':
+    const: 2
+
+  '#address-cells':
+    const: 1
+
+  '#size-cells':
+    const: 0
+
+patternProperties:
+  "^audio-codec@[0-9a-f]+$":
+    type: object
+    $ref: /schemas/sound/sprd,sc2723-codec.yaml#
+
+  "^gpio@[0-9a-f]+$":
+    type: object
+    $ref: /schemas/gpio/sprd,gpio-eic.yaml#
+
+  "^rtc@[0-9a-f]+$":
+    type: object
+    $ref: /schemas/rtc/sprd,sc2731-rtc.yaml#
+
+required:
+  - compatible
+  - interrupts
+  - interrupt-controller
+  - '#interrupt-cells'
+  - '#address-cells'
+  - '#size-cells'
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/interrupt-controller/arm-gic.h>
+    #include <dt-bindings/interrupt-controller/irq.h>
+
+    pmic: pmic {
+        compatible = "sprd,sc2723-adi-pmic";
+        interrupts = <GIC_SPI 38 IRQ_TYPE_LEVEL_HIGH>;
+        interrupt-controller;
+        #interrupt-cells = <2>;
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        rtc@80 {
+            compatible = "sprd,sc2731-rtc";
+            reg = <0x80>;
+            interrupt-parent = <&pmic>;
+            interrupts = <2 IRQ_TYPE_LEVEL_HIGH>;
+        };
+
+        gpio@100 {
+            compatible = "sprd,sc2731-eic";
+            reg = <0x100>;
+            interrupt-parent = <&pmic>;
+            interrupts = <5 IRQ_TYPE_LEVEL_HIGH>;
+            gpio-controller;
+            #gpio-cells = <2>;
+            interrupt-controller;
+            #interrupt-cells = <2>;
+        };
+
+        audio-codec@600 {
+            compatible = "sprd,sc2723-codec";
+            reg = <0x600>;
+            #sound-dai-cells = <0>;
+        };
+    };
+...
diff --git a/Documentation/devicetree/bindings/mmc/sprd,sc7730-sdhci.yaml b/Documentation/devicetree/bindings/mmc/sprd,sc7730-sdhci.yaml
new file mode 100644
index 000000000..9c8e32ffc
--- /dev/null
+++ b/Documentation/devicetree/bindings/mmc/sprd,sc7730-sdhci.yaml
@@ -0,0 +1,167 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/mmc/sprd,sc7730-sdhci.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Spreadtrum SC7730 SD/SDIO/eMMC host controller
+
+maintainers:
+  - Deniz Kokden <koekdendeniz@gmail.com>
+
+description: |
+  SDHCI 3.0 compatible hosts of the SC7730 and the other SoCs of the
+  SC8830 ("shark") family: SDIO0 to SDIO2 and the eMMC host. Not
+  compatible with the later Spreadtrum hosts (sprd,sdhci-r11). The
+  capabilities register does not report the base clock and ADMA is not
+  supported.
+
+  The base clock comes from a mux in the AP clock block, one 32-bit
+  configuration register per host ("clk-cfg" region): bits 1:0 select one
+  of four parent clocks, and for SDIO0 bits 10:8 hold an additional divider
+  (divide by n + 1).
+
+  Clock gate and soft reset of the hosts are bits in the AP AHB clock
+  enable register (EB, offset 0x0) and reset register (RST, offset 0x4),
+  for example EB bit 8 / RST bit 11 for SDIO0 and EB bit 9 / RST bit 12
+  for SDIO1. These registers are shared with other AP AHB peripherals; the
+  optional "ap-ahb" region points there.
+
+  The hosts have programmable delay lines for the data sampling clock,
+  which double data rate modes need.
+
+properties:
+  compatible:
+    const: sprd,sc7730-sdhci
+
+  reg:
+    minItems: 2
+    items:
+      - description: SDHCI registers
+      - description: Base clock configuration register of this host
+      - description: AP AHB clock enable and reset registers
+
+  reg-names:
+    minItems: 2
+    items:
+      - const: sdhci
+      - const: clk-cfg
+      - const: ap-ahb
+
+  interrupts:
+    maxItems: 1
+
+  sprd,clk-parent-rates:
+    $ref: /schemas/types.yaml#/definitions/uint32-array
+    description:
+      Rates in Hz of the four parent clocks of the base clock mux, in the
+      order of the mux selector (eMMC and SDIO0 26, 256, 312 and 384 MHz,
+      SDIO1 48, 76.8, 96 and 128 MHz on the SC7730).
+    minItems: 4
+    maxItems: 4
+
+  sprd,clk-sel:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    maximum: 3
+    description:
+      Parent clock to select in the base clock mux. Without it the
+      selection made by the boot loader is kept.
+
+  sprd,clk-has-div:
+    type: boolean
+    description:
+      The base clock configuration register of this host has a divider in
+      bits 10:8.
+
+  sprd,ahb-eb-bit:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    maximum: 31
+    description: Bit of this host in the AP AHB clock enable register.
+
+  sprd,ahb-rst-bit:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    maximum: 31
+    description: Bit of this host in the AP AHB soft reset register.
+
+  sprd,write-delay:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    description: Delay line setting for the write data clock in DDR modes.
+
+  sprd,read-pos-delay:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    description:
+      Delay line setting for sampling read data on the positive clock edge
+      in DDR modes.
+
+  sprd,read-neg-delay:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    description:
+      Delay line setting for sampling read data on the negative clock edge
+      in DDR modes.
+
+required:
+  - compatible
+  - reg
+  - reg-names
+  - interrupts
+  - sprd,clk-parent-rates
+
+allOf:
+  - $ref: sdhci-common.yaml#
+  - if:
+      properties:
+        reg-names:
+          contains:
+            const: ap-ahb
+    then:
+      required:
+        - sprd,ahb-eb-bit
+        - sprd,ahb-rst-bit
+    else:
+      properties:
+        sprd,ahb-eb-bit: false
+        sprd,ahb-rst-bit: false
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/interrupt-controller/arm-gic.h>
+
+    mmc@20600000 {
+        compatible = "sprd,sc7730-sdhci";
+        reg = <0x20600000 0x1000>, <0x71200054 0x4>;
+        reg-names = "sdhci", "clk-cfg";
+        interrupts = <GIC_SPI 60 IRQ_TYPE_LEVEL_HIGH>;
+        sprd,clk-parent-rates = <26000000 256000000 312000000 384000000>;
+        bus-width = <8>;
+        non-removable;
+        no-sd;
+        no-sdio;
+        no-1-8-v;
+        cap-mmc-highspeed;
+        mmc-ddr-3_3v;
+        max-frequency = <52000000>;
+        sprd,write-delay = <0x08>;
+        sprd,read-pos-delay = <0x04>;
+        sprd,read-neg-delay = <0x04>;
+    };
+
+  - |
+    #include <dt-bindings/interrupt-controller/arm-gic.h>
+
+    mmc@20300000 {
+        compatible = "sprd,sc7730-sdhci";
+        reg = <0x20300000 0x1000>, <0x71200048 0x4>, <0x20d00000 0x8>;
+        reg-names = "sdhci", "clk-cfg", "ap-ahb";
+        interrupts = <GIC_SPI 57 IRQ_TYPE_LEVEL_HIGH>;
+        sprd,clk-parent-rates = <26000000 256000000 312000000 384000000>;
+        sprd,clk-sel = <3>;
+        sprd,clk-has-div;
+        sprd,ahb-eb-bit = <8>;
+        sprd,ahb-rst-bit = <11>;
+        bus-width = <4>;
+        no-1-8-v;
+        cap-sd-highspeed;
+    };
+...

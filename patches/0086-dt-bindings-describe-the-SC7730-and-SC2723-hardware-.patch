+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/thermal/sprd,sc7730-thermal.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Spreadtrum SC7730 on-die temperature sensor
+
+maintainers:
+  - Deniz Kokden <koekdendeniz@gmail.com>
+
+description: |
+  Temperature sensor of the SC7730 application processor die. Once enabled
+  it converts periodically (for example every 2.25 s); the
+  reading is linear in temperature (623 at -40 C, 1030 at 120 C) and can
+  raise interrupts at programmable thresholds. Not compatible with the
+  multi-sensor controller of the later Spreadtrum SoCs (sprd,ums512-thermal).
+
+  Its clock gate (AON APB EB1 bit 1), its RTC clock gates (RTC_EB bits 10,
+  11 and 13) and its soft reset (RST1 bit 1) are bits in AON APB registers
+  shared with other always-on peripherals; the "aon-apb" region points
+  there.
+
+allOf:
+  - $ref: thermal-sensor.yaml#
+
+properties:
+  compatible:
+    const: sprd,sc7730-thermal
+
+  reg:
+    items:
+      - description: Temperature sensor registers
+      - description: AON APB clock enable and reset registers
+
+  reg-names:
+    items:
+      - const: thm
+      - const: aon-apb
+
+  interrupts:
+    maxItems: 1
+
+  '#thermal-sensor-cells':
+    const: 0
+
+required:
+  - compatible
+  - reg
+  - reg-names
+  - '#thermal-sensor-cells'
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    thermal-sensor@402f0000 {
+        compatible = "sprd,sc7730-thermal";
+        reg = <0x402f0000 0x1000>, <0x402e0000 0x4000>;
+        reg-names = "thm", "aon-apb";
+        #thermal-sensor-cells = <0>;
+    };
+...

+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/sound/sprd,sc2723-codec.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Spreadtrum SC2723 PMIC analog audio codec
+
+maintainers:
+  - Deniz Kokden <koekdendeniz@gmail.com>
+
+description: |
+  Analog part of the audio codec in the SC2723 PMIC, the companion chip
+  of the SC7730/SC8830 SoCs: DACs and ADCs, the headphone, earpiece and
+  speaker drivers and the internal class AB/D speaker amplifier. The
+  digital part (filters, sample rate) sits in the SoC (sprd,sc7730-vbc),
+  connected by an internal link. The codec is a sub-function of the PMIC
+  and is accessed through the PMIC's registers (analog block at 0x600,
+  global audio enables and resets at 0x800 and up).
+
+allOf:
+  - $ref: dai-common.yaml#
+
+properties:
+  compatible:
+    const: sprd,sc2723-codec
+
+  reg:
+    maxItems: 1
+    description: Offset of the analog audio registers in the PMIC
+
+  '#sound-dai-cells':
+    const: 0
+
+required:
+  - compatible
+  - reg
+  - '#sound-dai-cells'
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    pmic {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        audio-codec@600 {
+            compatible = "sprd,sc2723-codec";
+            reg = <0x600>;
+            #sound-dai-cells = <0>;
+        };
+    };
+...

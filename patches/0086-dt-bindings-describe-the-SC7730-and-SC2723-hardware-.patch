+    #include <dt-bindings/gpio/gpio.h>
+
+    i2c {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        camera@56 {
+            compatible = "samsung,s5k4ecgx";
+            reg = <0x56>;
+            clocks = <&dcam>;
+            avdd-supply = <&vddcama>;
+            dovdd-supply = <&vddcamio>;
+            dvdd-supply = <&cam_dvdd>;
+            reset-gpios = <&gpio 186 GPIO_ACTIVE_LOW>;
+            powerdown-gpios = <&gpio 188 GPIO_ACTIVE_LOW>;

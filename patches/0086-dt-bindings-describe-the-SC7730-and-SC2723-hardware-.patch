--- /dev/null
+++ b/Documentation/devicetree/bindings/clock/sprd,sc7730-aux0-clk.yaml
@@ -0,0 +1,51 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/clock/sprd,sc7730-aux0-clk.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Spreadtrum SC7730 CLK_AUX0 output
+
+maintainers:
+  - Deniz Kokden <koekdendeniz@gmail.com>
+
+description: |
+  The CLK_AUX0 clock output pad of the SC7730, typically the 32.768 kHz
+  low power clock of a WLAN/Bluetooth chip. Its gate is bit 2 of the AON
+  APB clock enable register EB1 (offset 0x4) and its source and divider
+  are fields of AON_CGM_CFG (offset 0x3020), in the AON APB register block,
+  which is shared with other always-on peripherals. The output is the
+  32.768 kHz clock, divided by one.
+
+properties:
+  compatible:
+    const: sprd,sc7730-aux0-clk
+
+  reg:
+    maxItems: 1
+    description: AON APB register block
+
+  clocks:
+    maxItems: 1
+    description: The 32.768 kHz clock
+
+  '#clock-cells':
+    const: 0
+
+required:
+  - compatible
+  - reg
+  - clocks
+  - '#clock-cells'
+
+additionalProperties: false
+
+examples:
+  - |
+    clock-controller@402e0000 {
+        compatible = "sprd,sc7730-aux0-clk";
+        reg = <0x402e0000 0x4000>;
+        clocks = <&ext_32k>;
+        #clock-cells = <0>;
+    };
+...
diff --git a/Documentation/devicetree/bindings/clock/sprd,sc7730-cpu-clk.yaml b/Documentation/devicetree/bindings/clock/sprd,sc7730-cpu-clk.yaml
new file mode 100644
index 000000000..edf010b1b
--- /dev/null
+++ b/Documentation/devicetree/bindings/clock/sprd,sc7730-cpu-clk.yaml
@@ -0,0 +1,54 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/clock/sprd,sc7730-cpu-clk.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Spreadtrum SC7730 Cortex-A7 cluster clock
+
+maintainers:
+  - Deniz Kokden <koekdendeniz@gmail.com>
+
+description: |
+  Clock of the Cortex-A7 cluster of the SC7730. CA7_CKG_CFG in the AP AHB
+  block selects the core clock source (bits 2:0, for example the 768 MHz
+  TDPLL output or the MPLL) and the AXI and debug dividers (bits 10:8 and
+  18:16). The MPLL, used only for the cluster, is set in MPLL_CFG1 in the
+  AON APB block, 26 MHz * (NINT + KINT / 2^20) with a 6-bit NINT, which
+  limits it to about 1.6 GHz. Both registers sit in blocks shared with
+  other peripherals.
+
+properties:
+  compatible:
+    const: sprd,sc7730-cpu-clk
+
+  reg:
+    items:
+      - description: CA7_CKG_CFG register
+      - description: MPLL_CFG1 register
+
+  reg-names:
+    items:
+      - const: ckg
+      - const: mpll
+
+  '#clock-cells':
+    const: 0
+
+required:
+  - compatible
+  - reg
+  - reg-names
+  - '#clock-cells'
+
+additionalProperties: false
+
+examples:
+  - |
+    clock-controller@20d03000 {
+        compatible = "sprd,sc7730-cpu-clk";
+        reg = <0x20d03000 0x4>, <0x402e3070 0x4>;
+        reg-names = "ckg", "mpll";
+        #clock-cells = <0>;
+    };
+...

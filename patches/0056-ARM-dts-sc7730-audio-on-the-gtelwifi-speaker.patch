From 8584c79ab87cf14af6f14006b8a2f13da9b42f40 Mon Sep 17 00:00:00 2001
From: Deniz Kokden <koekdendeniz@gmail.com>
Date: Mon, 2 Nov 2026 11:29:35 +0000
Subject: [PATCH 056/109] ARM: dts: sc7730: audio on the gtelwifi speaker

AP AHB gates as a clock controller (for the DMA enable), the AP DMA
(sprd,sc7730-dma, SPI 50), the VBC, the SC2723 codec under the PMIC, the
PCM platform with request IDs 29/30 and a simple-audio-card for the
mono speaker.

Assisted-by: Claude Opus 5.5
Signed-off-by: Deniz Kokden <koekdendeniz@gmail.com>
---
 .../dts/unisoc/sc7730-samsung-gtelwifi.dts    | 39 +++++++++++++
 arch/arm/boot/dts/unisoc/sc7730.dtsi          | 58 +++++++++++++++++++
 2 files changed, 97 insertions(+)

diff --git a/arch/arm/boot/dts/unisoc/sc7730-samsung-gtelwifi.dts b/arch/arm/boot/dts/unisoc/sc7730-samsung-gtelwifi.dts
index a7c4d79cb..1a2f74355 100644
--- a/arch/arm/boot/dts/unisoc/sc7730-samsung-gtelwifi.dts
+++ b/arch/arm/boot/dts/unisoc/sc7730-samsung-gtelwifi.dts
@@ -70,6 +70,25 @@ charger: charger@6a {
 	 * hardware reset in the PMIC, independent of the kernel. The EIC
 	 * debounces in hardware, 50 ms as the bootloader sets it.
 	 */
+	sound {
+		compatible = "simple-audio-card";
+		simple-audio-card,name = "gtelwifi";
+		simple-audio-card,widgets = "Speaker", "Speaker";
+		simple-audio-card,routing = "Speaker", "SPK";
+
+		simple-audio-card,cpu {
+			sound-dai = <&vbc>;
+		};
+
+		simple-audio-card,plat {
+			sound-dai = <&audio_pcm>;
+		};
+
+		simple-audio-card,codec {
+			sound-dai = <&sc2723_codec>;
+		};
+	};
+
 	gpio-keys {
 		compatible = "gpio-keys";
 
@@ -372,6 +391,26 @@ &gpu {
 	status = "okay";
 };
 
+/*
+ * Mono internal speaker on the SC2723's AOL output and internal PA, fed
+ * by the VBC through the AP DMA. Headphones and capture to come.
+ */
+&ap_dma {
+	status = "okay";
+};
+
+&vbc {
+	status = "okay";
+};
+
+&audio_pcm {
+	status = "okay";
+};
+
+&sc2723_codec {
+	status = "okay";
+};
+
 /*
  * Takes over the DSI video-mode pipeline the bootloader leaves running and
  * sends simpledrm away; the backlight follows the CRTC as with simpledrm.
diff --git a/arch/arm/boot/dts/unisoc/sc7730.dtsi b/arch/arm/boot/dts/unisoc/sc7730.dtsi
index 65281c3b8..9f5da0c3b 100644
--- a/arch/arm/boot/dts/unisoc/sc7730.dtsi
+++ b/arch/arm/boot/dts/unisoc/sc7730.dtsi
@@ -72,6 +72,14 @@ rtc@80 {
 			interrupts = <2 IRQ_TYPE_LEVEL_HIGH>;
 		};
 
+		/* analog audio codec, mono speaker path (sound/soc/codecs/sc2723-codec.c) */
+		sc2723_codec: audio-codec@600 {
+			compatible = "sprd,sc2723-codec";
+			reg = <0x600>;
+			#sound-dai-cells = <0>;
+			status = "disabled";
+		};
+
 		pmic_eic: gpio@100 {
 			compatible = "sprd,sc2731-eic";
 			reg = <0x100>;
@@ -84,6 +92,18 @@ pmic_eic: gpio@100 {
 		};
 	};
 
+	/*
+	 * Spreadtrum PCM platform: one AP DMA channel per audio channel, fed
+	 * by the VBC FIFO requests (UID 29/30 = DA0/DA1).
+	 */
+	audio_pcm: audio-platform {
+		compatible = "sprd,pcm-platform";
+		dmas = <&ap_dma 29>, <&ap_dma 30>;
+		dma-names = "normal_p_l", "normal_p_r";
+		#sound-dai-cells = <0>;
+		status = "disabled";
+	};
+
 	/* SC2723 auxiliary ADC (mach-sprd/sc2723-adc.c), raw counts */
 	pmic_adc: adc {
 		compatible = "sprd,sc2723-adc-polled";
@@ -145,6 +165,44 @@ pmu_domains: power-controller@402b0000 {
 			#power-domain-cells = <1>;
 		};
 
+		/* AP AHB enable bits as gate clocks (mach-sprd/clk-gates.c) */
+		ap_ahb_gates: clock-controller@20d00000 {
+			compatible = "sprd,sc7730-gates";
+			reg = <0x20d00000 0x4>;
+			clocks = <&ext_26m>;
+			#clock-cells = <1>;
+		};
+
+		/*
+		 * AP DMA (r4p0, the SC9860 layout), gate AP_AHB bit 5, off after
+		 * the bootloader. Only channels 24-31 are "full" channels. Audio
+		 * request IDs: VB_DA0/1 = 29/30, VB_AD0-3 = 31-34.
+		 */
+		ap_dma: dma-controller@20100000 {
+			compatible = "sprd,sc7730-dma", "sprd,sc9860-dma";
+			reg = <0x20100000 0x4000>;
+			interrupts = <GIC_SPI 50 IRQ_TYPE_LEVEL_HIGH>;
+			clocks = <&ap_ahb_gates 5>;
+			clock-names = "enable";
+			#dma-cells = <1>;
+			dma-channels = <32>;
+			status = "disabled";
+		};
+
+		/*
+		 * Voice band codec FIFOs and the digital DAC part ("DP") of the
+		 * audio codec; clocks, resets and the hand-over from the modem
+		 * side in AON APB (sound/soc/sprd/sprd-vbc-sc7730.c).
+		 */
+		vbc: audio-controller@40020000 {
+			compatible = "sprd,sc7730-vbc";
+			reg = <0x40020000 0x1000>, <0x40000000 0x1000>,
+			      <0x402e0000 0x4000>;
+			reg-names = "vbc", "dp", "aon-apb";
+			#sound-dai-cells = <0>;
+			status = "disabled";
+		};
+
 		/*
 		 * Display controller. Its clocks and gates (AP_AHB EB bit 1,
 		 * AON_APB EB1 bit 11, AP_APB EB bit 18, AP_CLK 0x2c-0x34) are
-- 
2.34.1


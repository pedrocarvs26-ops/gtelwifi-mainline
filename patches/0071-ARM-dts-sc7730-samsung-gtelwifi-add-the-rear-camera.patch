From 9ab6a0e41d71baaa35f6380c954298071060b39b Mon Sep 17 00:00:00 2001
From: Deniz Kokden <koekdendeniz@gmail.com>
Date: Mon, 2 Nov 2026 16:06:11 +0000
Subject: [PATCH 071/110] ARM: dts: sc7730-samsung-gtelwifi: add the rear
 camera

The rear S5K4ECGX sits on I2C0 at 0x56 and D-PHY A (two lanes), with
reset GPIO 186 and powerdown GPIO 188 (both active low) and an
external 1.2 V core supply switched by GPIO 193.

Add the rotation of both cameras relative to the portrait panel, found
with test shots held upright: the scene's top lands on the left of the
rear image (270 degrees) and on the right of the front image (90).

Assisted-by: Claude Opus 5.5
Signed-off-by: Deniz Kokden <koekdendeniz@gmail.com>
---
 .../dts/unisoc/sc7730-samsung-gtelwifi.dts    | 47 +++++++++++++++++--
 1 file changed, 44 insertions(+), 3 deletions(-)

diff --git a/arch/arm/boot/dts/unisoc/sc7730-samsung-gtelwifi.dts b/arch/arm/boot/dts/unisoc/sc7730-samsung-gtelwifi.dts
index 5b1fe431f..33c64ce5c 100644
--- a/arch/arm/boot/dts/unisoc/sc7730-samsung-gtelwifi.dts
+++ b/arch/arm/boot/dts/unisoc/sc7730-samsung-gtelwifi.dts
@@ -333,6 +333,17 @@ vddcamio: regulator-vddcamio {
 		regulator-max-microvolt = <1800000>;
 	};
 
+	/* external 1.2 V core supply of the rear camera */
+	cam_dvdd: regulator-cam-dvdd {
+		compatible = "regulator-fixed";
+		regulator-name = "cam_dvdd";
+		regulator-min-microvolt = <1200000>;
+		regulator-max-microvolt = <1200000>;
+		gpio = <&gpio 193 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		startup-delay-us = <1000>;
+	};
+
 	backlight: backlight {
 		compatible = "pwm-backlight";
 		pwms = <&pwm 3 49039>;
@@ -352,9 +363,11 @@ &pwm {
 };
 
 /*
- * Camera sensors: rear S5K4ECGX @ 0x56 (no driver yet), front SR200PC20M
- * @ 0x20 on D-PHY C. The front does not need the external 1.2 V DVDD
- * (GPIO 193) the vendor pulses.
+ * Camera sensors: rear S5K4ECGX @ 0x56 on D-PHY A, front SR200PC20M @ 0x20
+ * on D-PHY C. Only the rear needs the external 1.2 V DVDD (GPIO 193); the
+ * vendor also pulses it for the front, which works without. Rotations
+ * relative to the portrait panel, from test shots: the scene's top lands
+ * on the left of the rear image and on the right of the front image.
  */
 &i2c0 {
 	status = "okay";
@@ -368,6 +381,7 @@ camera@20 {
 		reset-gpios = <&gpio 238 GPIO_ACTIVE_LOW>;
 		powerdown-gpios = <&gpio 187 GPIO_ACTIVE_LOW>;
 		orientation = <0>;
+		rotation = <90>;
 
 		port {
 			front_camera_out: endpoint {
@@ -376,12 +390,39 @@ front_camera_out: endpoint {
 			};
 		};
 	};
+
+	camera@56 {
+		compatible = "samsung,s5k4ecgx";
+		reg = <0x56>;
+		clocks = <&dcam>;
+		avdd-supply = <&vddcama>;
+		dovdd-supply = <&vddcamio>;
+		dvdd-supply = <&cam_dvdd>;
+		reset-gpios = <&gpio 186 GPIO_ACTIVE_LOW>;
+		powerdown-gpios = <&gpio 188 GPIO_ACTIVE_LOW>;
+		orientation = <1>;
+		rotation = <270>;
+
+		port {
+			rear_camera_out: endpoint {
+				remote-endpoint = <&dcam_rear_in>;
+				data-lanes = <1 2>;
+			};
+		};
+	};
 };
 
 &dcam {
 	status = "okay";
 };
 
+&dcam_phy_a {
+	dcam_rear_in: endpoint {
+		remote-endpoint = <&rear_camera_out>;
+		data-lanes = <1 2>;
+	};
+};
+
 &dcam_phy_c {
 	dcam_front_in: endpoint {
 		remote-endpoint = <&front_camera_out>;
-- 

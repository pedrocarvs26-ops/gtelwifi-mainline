# gtelwifi for LineageOS/Android (DRAFT, never booted). Merged last.
#
# Merge order (lineageos/kernel/mergecheck.sh, as in LineageOS
# device/mainline/generic): buildkit/gtelwifi.config, buildkit/cfi.config,
# kernel/mainline/configs android-base-pre/common.config, AOSP android-base
# (android17-release b/android-6.12), CONFIG_ARM-y.config,
# kernel/mainline/configs common.config, this file.
# Only what is specific to this board or to our boot chain lives here.

# libvintf treats a release ending in "-mainline" or containing "-mainline-"
# as a mainline kernel and skips the kernel matrix (RuntimeInfo.cpp), 7.3 has
# no entry there. Kbuild appends "+" to an untagged git tree, so the marker
# goes in the middle: 7.3.1-mainline-gtelwifi+
CONFIG_LOCALVERSION="-mainline-gtelwifi"

# Ramdisk comes from the boot image (first stage init), not built in
CONFIG_INITRAMFS_SOURCE=""

# sboot drops the header cmdline, so everything Android needs from the
# cmdline has to be here. CMDLINE_EXTEND keeps sboot's own part in front
# (androidboot.serialno, androidboot.bootloader, console=null, lcd_base= ...).
# boot_devices: platform device of the eMMC host as first stage init names it:
# its path below /devices/platform/, so with the soc bus "soc/20600000.mmc"
# (plain "20600000.mmc" left /dev/block/by-name empty, first boot 04.11.).
# init creates /dev/block/by-name/<PARTNAME> from it (KERNEL, SYSTEM, ...).
# super_partition: super spans SYSTEM + CSC + HIDDEN, metadata on SYSTEM.
# The rest mirrors MAINLINE_COMMON_KERNEL_PARAMS/_ANDROIDBOOT_PARAMS of
# device/mainline/common (binder.impl=rust left out: 7.3 has the C binder).
# init_fatal_reboot_target=recovery lands in TWRP, pstore keeps the log.
# loglevel=4: every line printed on fbcon costs ~10 ms (median over the boot
# of 04.11., 1500 lines = ~15 s in which init, apexd and ueventd stall);
# kmsg itself stays complete (vendor/bin/gtelwifi-bootlog.sh).
# cma=: every gralloc buffer is a dumb buffer on sprd-dispc (no IOMMU), and
# the 64 MiB pool of the device tree ran out after a few 4 MB windows
# ("GraphicBufferAllocator: Failed to allocate (800 x 1280) … -12", HWUI then
# aborted in Settings, the setup wizard and the keyboard, 05.11.). The range
# is the free RAM between the modem (CP, ends 0x89c00000) and the bootloader
# framebuffer (0x9ea44000), 4 MiB aligned: 328 MiB, all lowmem. Measured
# 05.11.: setup wizard 31 MiB of buffers, six apps + recents + keyboard
# 53 MiB peak. 192 MiB is ~3.5 times that; 320 MiB left only ~35 MB
# non-CMA lowmem free after boot. Unused CMA still serves page cache and app
# memory. The cmdline value replaces the DT node.
CONFIG_CMDLINE="printk.devkmsg=on printk.time=1 loglevel=4 log_buf_len=4M cma=192M@0x8a000000-0x9e800000 loop.max_part=7 rw vt.global_cursor_default=0 panic=10 firmware_class.path=/vendor/firmware/ brcmfmac.feature_disable=0x2000 androidboot.hardware=gtelwifi androidboot.boot_devices=soc/20600000.mmc androidboot.super_partition=SYSTEM androidboot.selinux=permissive androidboot.verifiedbootstate=orange androidboot.init_fatal_reboot_target=recovery"
CONFIG_CMDLINE_EXTEND=y

# Nothing of the kernel on the display: the sboot Samsung logo stays up until
# the boot animation. With console=tty0 fbcon scrolled the kernel log over it
# (build n); without the console, the DRM fbdev client still switched the
# DISPC to its own uncleared CMA buffer at probe (white stripes, build p).
# sprd-dispc keeps scanning out the sboot framebuffer until the composer's
# first commit. Android needs no /dev/fb0 (fbkeyboard is off). Kernel
# messages still reach ramoops and /metadata; a panic no longer shows on the
# screen.
# CONFIG_DRM_FBDEV_EMULATION is not set

# Bring-up aid of the Nura days: paints a white band into the bootloader
# splash for every early boot stage. Between the Samsung logo and the boot
# animation these showed as white stripes (user, 05.11.). The splash buffer
# stays reserved by the framebuffer node in reserved-memory.
# CONFIG_SPRD_BOOTSTRIPES is not set

# Game controllers (user, 05.11.): DualShock 3/4 and DualSense, Switch Pro
# and Joy-Con, Xbox over Bluetooth, with rumble. xpad (Xbox over USB) comes
# from the Android base config already.
# The controller drivers drive the light bars and player LEDs.
CONFIG_NEW_LEDS=y
CONFIG_LEDS_CLASS=y
CONFIG_LEDS_CLASS_MULTICOLOR=y
CONFIG_HID_SONY=y
CONFIG_SONY_FF=y
CONFIG_HID_PLAYSTATION=y
CONFIG_PLAYSTATION_FF=y
CONFIG_HID_NINTENDO=y
CONFIG_NINTENDO_FF=y
CONFIG_HID_MICROSOFT=y
CONFIG_JOYSTICK_XPAD_FF=y

# Modules from /vendor_dlkm: brcmfmac and btbcm need their firmware from
# the vendor side, which is not mounted when built-in drivers probe (the
# same problem as the Alpine rootfs, there solved by an SDIO rebind)
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_CFG80211=m
CONFIG_BRCMFMAC=m
CONFIG_BRCMFMAC_SDIO=y
CONFIG_BT=m
CONFIG_BT_HCIUART=m
CONFIG_BT_HCIUART_BCM=y
CONFIG_SERIAL_DEV_BUS=y

# libprocessgroup mounts the v1 cpuset hierarchy unconditionally
CONFIG_CPUSETS=y
CONFIG_CPUSETS_V1=y

# Cortex-A7 has no AES instructions -> Adiantum (fileencryption=adiantum)
CONFIG_FS_ENCRYPTION=y
CONFIG_CRYPTO_ADIANTUM=y
CONFIG_EROFS_FS_ZIP=y
CONFIG_EXT4_FS_SECURITY=y
# Casefolded /data/media (external_storage.casefold.enabled, fs_mgr runs
# tune2fs -O casefold when the kernel offers it)
CONFIG_UNICODE=y

# ART's userfaultfd GC: the build compiles the boot images for it, and
# without the syscall odrefresh threw them away and recompiled everything
# on /data at every boot (73 s, "Userfaultfd GC check failed", 04.11.)
CONFIG_USERFAULTFD=y

# Android does not use these (AOSP base wants them off)
CONFIG_SYSVIPC=n
CONFIG_FHANDLE=n

# Bring-up only: keep /dev/mem for register peeking (AOSP wants DEVMEM=n,
# turn it off for anything beyond userdebug bring-up)
CONFIG_DEVMEM=y
CONFIG_STRICT_DEVMEM=n

# Dependencies the allnoconfig base leaves off, without them TUN/VETH/IFB,
# the inet diag options, uinput and the cgroup scheduler knobs of the AOSP
# and LineageOS lists drop out of the merged config
CONFIG_NET_CORE=y
CONFIG_INET_DIAG=y
CONFIG_NET_ACT_MIRRED=y
CONFIG_INPUT_MISC=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_UCLAMP_TASK=y
CONFIG_HID_SUPPORT=y
CONFIG_HID=y

# The ARM32 eBPF JIT has no BPF_ATOMIC, which the netd and tethering
# programs use for their counters: with BPF_JIT_ALWAYS_ON (AOSP base) they
# fail to load ("*** NOT YET: opcode c3 ***", first boots 04.11.) and
# NetBpfLoad stops the boot. Without it the kernel interprets them; the
# JIT stays on for everything else. NetBpfLoad accepts that on a 32-bit Arm
# kernel (lineageos/patches/packages_modules_Connectivity/0002).
# CONFIG_BPF_JIT_ALWAYS_ON is not set

# /dev/hw_random for prng_seeder (FIPS BoringSSL seeds from it; without the
# device every first RAND call blocks on the daemon's socket). The SC7730 has
# no hardware RNG, mach-sprd/crng-hwrng.c serves the kernel CRNG.
CONFIG_HW_RANDOM=y

# Bring-up: lockup and hung task detectors. init.gtelwifi.rc turns their
# reports into panics, pstore keeps the trace for the next boot (one boot
# froze on 04.11. without a message). The hard lockup detector is the buddy
# variant here (no perf NMI on ARM32): another CPU notices a stuck one.
CONFIG_SOFTLOCKUP_DETECTOR=y
CONFIG_HARDLOCKUP_DETECTOR=y
CONFIG_DETECT_HUNG_TASK=y

# DISPC (patch 0047) scans out of contiguous memory (no IOMMU): CMA heap for
# gralloc's dmabuf-heap path next to the system heap from common.config
CONFIG_DMABUF_HEAPS_CMA=y

# Standby comes with patches 0041-0043 (SC2723 interrupts, power key on an
# IRQ, suspend to RAM). Untested under Android: TARGET_INITIAL_BRINGUP keeps
# suspend_blocker running until it is.
CONFIG_SUSPEND=y
CONFIG_PM_WAKELOCKS=y
CONFIG_PM_WAKELOCKS_GC=y
